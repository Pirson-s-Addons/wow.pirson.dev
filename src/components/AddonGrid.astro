---
// Every addon as a bag of items, most downloaded first. `lang` comes from the page that embeds it.
import addons from '../data/addons.json';
import { t, href } from '../lib/i18n';

interface Props {
	lang: 'en' | 'es';
}
const { lang } = Astro.props;
const l = lang === 'es' ? 1 : 0;
---

<ul class="addon-grid not-content">
	{
		addons.map((a) => (
			<li style={`--q:${a.color}`}>
				<a href={href(lang, `addons/${a.slug}`)}>
					<img class="item-icon" src={`/logos/${a.id}.webp`} alt="" width="56" height="56" loading="lazy" />
					<span class="name">{a.name}</span>
					<span class="one">{a.one[l]}</span>
					<span class="meta">
						{a.clients.length === 1 ? a.clients[0][l] : `${a.clients[0][l]} +${a.clients.length - 1}`}
						<span class="dl">
							{a.downloads.toLocaleString(lang)} {t(lang, 'downloads')}
						</span>
					</span>
				</a>
			</li>
		))
	}
</ul>
