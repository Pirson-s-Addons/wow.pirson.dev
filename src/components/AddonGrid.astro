---
// The library: every addon as an art tile, filtered by game version with launcher-style tabs.
// Hover or focus lifts the details (what it does, versions, downloads) over the art.
// Without JavaScript the tabs stay hidden and every tile shows.
import addons from '../data/addons.json';
import { covers } from '../lib/covers';
import { t, href } from '../lib/i18n';

interface Props {
	lang: 'en' | 'es';
}
const { lang } = Astro.props;
const es = lang === 'es';
const l = es ? 1 : 0;
const versions = [...new Set(addons.flatMap((a) => a.clients.map((c) => c[l])))];
const count = (v: string) => addons.filter((a) => a.clients.some((c) => c[l] === v)).length;
---

<div class="library not-content" data-catalog>
	<div class="tabs" role="group" aria-label={es ? 'Filtrar por versión del juego' : 'Filter by game version'} hidden data-filters>
		<button type="button" aria-pressed="true" data-v="">
			{es ? 'Todas' : 'All'} <span>{addons.length}</span>
		</button>
		{
			versions.map((v) => (
				<button type="button" aria-pressed="false" data-v={v}>
					{v} <span>{count(v)}</span>
				</button>
			))
		}
	</div>
	<ul class="shelf">
		{
			addons.map((a) => (
				<li data-versions={a.clients.map((c) => c[l]).join('|')} data-reveal>
					<a class="slot" href={href(lang, `addons/${a.slug}`)} style={`--q:${a.color}`} data-tilt>
						{covers[a.slug] ? <img class="slot-art" src={covers[a.slug]} alt="" loading="lazy" /> : <span class="slot-art slot-blank" />}
						<span class="slot-shade" />
						<img class="slot-logo" src={`/logos/${a.id}.webp`} alt="" width="52" height="52" loading="lazy" />
						<span class="slot-body">
							<span class="slot-name">{a.name}</span>
							<span class="slot-one">{a.one[l]}</span>
							<span class="slot-meta">
								<span>{a.clients.length === 1 ? a.clients[0][l] : `${a.clients[0][l]} +${a.clients.length - 1}`}</span>
								<span>
									{a.downloads.toLocaleString(lang)} {t(lang, 'downloads')}
								</span>
							</span>
						</span>
						<span class="tcg-glare" aria-hidden="true" />
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	for (const cat of document.querySelectorAll<HTMLElement>('[data-catalog]')) {
		const bar = cat.querySelector<HTMLElement>('[data-filters]')!;
		const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
		const items = [...cat.querySelectorAll<HTMLElement>('[data-versions]')];
		bar.hidden = false;
		for (const b of buttons) {
			b.addEventListener('click', () => {
				for (const o of buttons) o.setAttribute('aria-pressed', String(o === b));
				const v = b.dataset.v!;
				for (const it of items) it.hidden = !!v && !it.dataset.versions!.split('|').includes(v);
			});
		}
	}
</script>
