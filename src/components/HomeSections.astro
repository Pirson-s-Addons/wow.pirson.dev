---
// Home page body, in numbered chapters: the action bar of every addon, the lineup (each addon as a
// WoW item tooltip, filtered by game version with expansion logos), videos (silent preview on hover) and a screenshot
// marquee, principles and the closing band over in-game footage, install steps. Without JavaScript
// the era filter stays hidden.
// Sound: a floating button plays the music of the zone on screen (the hero's current clip, or a band's
// data-music), cross-fading between zones. Off until the visitor turns it on; the choice is remembered.
import { readdirSync } from 'node:fs';
import addons from '../data/addons.json';
import { covers } from '../lib/covers';
import { t, href, totalDownloads } from '../lib/i18n';

interface Props {
	lang: 'en' | 'es';
}
const { lang } = Astro.props;
const es = lang === 'es';
const l = es ? 1 : 0;
const w = (en: string, sp: string) => (es ? sp : en);
const versions = [...new Set(addons.flatMap((a) => a.clients.map((c) => c[0])))];
const count = (v: string) => addons.filter((a) => a.clients.some((c) => c[0] === v)).length;
// Every expansion in release order, with the game version (English client name) its addons run
// on; the ones no addon covers yet show dimmed.
const LEGACY = 'Legacy (WoD to Shadowlands)';
const eras: [file: string, name: string, year: string, client: string | null][] = [
	['classic', 'World of Warcraft', '2004', 'Classic Era'],
	['tbc', 'The Burning Crusade', '2007', 'TBC Classic'],
	['wrath', 'Wrath of the Lich King', '2008', 'Wrath Classic'],
	['cata', 'Cataclysm', '2010', 'Cataclysm Classic'],
	['mop', 'Mists of Pandaria', '2012', 'MoP Classic'],
	['wod', 'Warlords of Draenor', '2014', LEGACY],
	['legion', 'Legion', '2016', LEGACY],
	['bfa', 'Battle for Azeroth', '2018', LEGACY],
	['sl', 'Shadowlands', '2020', LEGACY],
	['df', 'Dragonflight', '2022', null],
	['sod', 'Season of Discovery', '2023', null],
	['tww', 'The War Within', '2024', null],
	['midnight', 'Midnight', '2026', 'Retail'],
	['forever', 'WoW Forever', '2026', 'WoW Forever'],
	['titan', 'The Last Titan', w('Next', 'Próxima'), null],
];
const clientName = (v: string) => addons.flatMap((a) => a.clients).find((c) => c[0] === v)![l];
const quality: Record<string, [string, string]> = {
	'#ff8000': ['Legendary', 'Legendario'],
	'#c77dff': ['Epic', 'Épico'],
	'#4aa3ff': ['Rare', 'Raro'],
	'#1eff00': ['Uncommon', 'Poco común'],
};
const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '='];

// Two screenshots of each addon for the marquee, read from public/ at build time.
const dir = 'public/images/addons';
const shots = readdirSync(dir).flatMap((d) =>
	readdirSync(`${dir}/${d}`)
		.filter((f) => !f.startsWith('maxresdefault'))
		.slice(0, 2)
		.map((f) => `/images/addons/${d}/${f}`),
);
const rows = [shots.filter((_, i) => i % 2 === 0), shots.filter((_, i) => i % 2 === 1)];

const videos = [
	['dungeon-quest-atlas', 'AYYhYFyfzfY'],
	['wow-translator', 'DmyrbF9iDdQ'],
	['emoji-react', 'E3wdcegOrYo'],
	['cursor-glow-rgb', 'DhS620RpkQA'],
].map(([slug, id]) => {
	const thumb = readdirSync(`${dir}/${slug}`).find((f) => f.startsWith('maxresdefault'));
	return {
		a: addons.find((a) => a.slug === slug)!,
		id,
		thumb: thumb ? `/images/addons/${slug}/${thumb}` : `/media/preview/${slug}.webp`,
		preview: `/media/preview/${slug}.mp4`,
	};
});

const icons = ['inv_crate_05', 'inv_jewelry_ring_34', 'inv_misc_note_01', 'inv_jewelry_necklace_14', 'inv_misc_food_legion_gooslime_bottle', 'inv_torch_lit'];
const principles = [
	[w('Free, for good', 'Gratis, para siempre'), w('No premium tiers, no ads, no account. Install it and play.', 'Sin versiones premium, sin anuncios, sin cuentas. Lo instalas y a jugar.')],
	[w('Every client', 'Todos los clientes'), w('WoW Forever first, then MoP Classic, Classic Era, Retail and everything in between.', 'Primero WoW Forever, y también MoP Classic, Classic Era, Retail y todo lo que hay en medio.')],
	[w('Speaks your language', 'Habla tu idioma'), w('Every addon ships in 20 languages, from English and Español to 한국어 and 中文.', 'Cada addon viene en 20 idiomas, del inglés y el español al 한국어 y el 中文.')],
	[w('Looks like the game', 'Parece del juego'), w('Option panels built with the game’s own templates, so nothing feels bolted on.', 'Paneles de opciones hechos con las plantillas del propio juego: nada parece un pegote.')],
	[w('Tested before release', 'Probado antes de publicar'), w('Automated tests run every addon against the real game API before it ships.', 'Tests automáticos prueban cada addon contra la API real del juego antes de publicarlo.')],
	[w('Every command explained', 'Cada comando explicado'), w('A full guide per addon, in English and Spanish: what it does, how to set it up, every command.', 'Una guía completa por addon, en inglés y español: qué hace, cómo configurarlo y todos sus comandos.')],
];
---

<div class="home not-content">
	<!-- 01 · action bar -->
	<section class="chapter" data-reveal>
		<header class="sec-head">
			<p class="eyebrow"><i class="glyph" aria-hidden="true">&#x2694;</i><span>01</span> / {w('The armory', 'La armería')}</p>
			<p class="mono">{addons.length} addons · {versions.length} {w('game versions', 'versiones del juego')} · {totalDownloads} {t(lang, 'downloads')}</p>
			<h2>{w(`${addons.length} addons. One Azeroth.`, `${addons.length} addons. Un Azeroth.`)}</h2>
			<p class="lead">
				{w(
					'Small tools that fix what the game leaves out: dungeon quests, maps, unit frames, PvP timers, chat and more. Pick one from the bar.',
					'Pequeñas herramientas que arreglan lo que el juego se deja: misiones de mazmorra, mapas, marcos de unidad, PvP, chat y más. Elige uno de la barra.',
				)}
			</p>
		</header>
		<nav class="actionbar" aria-label="Addons">
			{
				addons.map((a, i) => (
					<a class="ab-slot" href={href(lang, `addons/${a.slug}`)} style={`--q:${a.color}`} title={a.name}>
						<img src={`/logos/${a.id}.webp`} alt={a.name} width="56" height="56" loading="lazy" />
						{i < keys.length && <span class="ab-key">{keys[i]}</span>}
					</a>
				))
			}
		</nav>
	</section>

	<!-- 02 · lineup -->
	<section class="chapter" id="the-library" data-catalog>
		<header class="sec-head">
			<p class="eyebrow"><i class="glyph" aria-hidden="true">&#x1F48E;</i><span>02</span> / {w('The lineup', 'El catálogo')}</p>
			<h2>{w('Pick your loot.', 'Elige tu botín.')}</h2>
		</header>
		<div class="eras" role="group" aria-label={w('Filter by game version', 'Filtrar por versión del juego')} hidden data-filters>
			<button type="button" class="era" aria-pressed="true" data-v="">
				<span class="era-art era-all">{addons.length}</span>
				<span class="era-name">{w('All', 'Todas')}</span>
			</button>
			{
				eras.map(([file, name, year, v]) => {
					const body = (
						<>
							<span class="era-art">
								<img src={`/media/eras/${file}.webp`} alt="" loading="lazy" />
							</span>
							<span class="era-year mono">{year}</span>
							<span class="era-name">{name}</span>
							<span class="era-n">
								{v ? `${count(v)} addons` : w('No addons yet', 'Aún sin addons')}
							</span>
						</>
					);
					return v ? (
						<button type="button" class="era" aria-pressed="false" data-v={v} title={`${name} · ${clientName(v)}`}>
							{body}
						</button>
					) : (
						<span class="era is-off">{body}</span>
					);
				})
			}
		</div>
		<ol class="lineup">
			{
				addons.map((a, i) => (
					<li data-versions={a.clients.map((c) => c[0]).join('|')} data-reveal>
						<a class="loot" href={href(lang, `addons/${a.slug}`)} style={`--q:${a.color}`} data-tilt>
							<span class="loot-art">
								{covers[a.slug] ? <img src={covers[a.slug]} alt="" loading="lazy" /> : <span class="slot-blank" />}
								<span class="loot-num">{String(i + 1).padStart(2, '0')}</span>
							</span>
							<span class="loot-tip">
								<img class="loot-logo" src={`/logos/${a.id}.webp`} alt="" width="52" height="52" loading="lazy" />
								<span class="loot-name">{a.name}</span>
								<span class="loot-q">{(quality[a.color] ?? quality['#1eff00'])[l]} · {a.cat[l]}</span>
								<span class="loot-row">
									<span>{w('Downloads', 'Descargas')}</span>
									<span>{a.downloads.toLocaleString(lang)}</span>
								</span>
								<span class="loot-use">
									{w('Use:', 'Uso:')} {a[lang]}
								</span>
								<span class="loot-req">
									{w('Requires', 'Requiere')} {a.clients.length === 1 ? a.clients[0][l] : `${a.clients[0][l]} +${a.clients.length - 1}`}
								</span>
								<span class="loot-go">{w(`Explore ${a.name}`, `Ver ${a.name}`)} →</span>
							</span>
							<span class="tcg-glare" aria-hidden="true" />
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<!-- 03 · videos and screenshots -->
	<section class="chapter" data-reveal>
		<header class="sec-head">
			<p class="eyebrow"><i class="glyph" aria-hidden="true">&#x1F4DC;</i><span>03</span> / {w('In action', 'En acción')}</p>
			<h2>{w('See them in the game.', 'Míralos en el juego.')}</h2>
		</header>
		<div class="videos">
			{
				videos.map(({ a, id, thumb, preview }) => (
					<figure class="video" style={`--q:${a.color}`}>
						<button type="button" class="video-play" data-yt={id} aria-label={`${w('Play', 'Reproducir')}: ${a.name}`}>
							<img src={thumb} alt="" loading="lazy" />
							<video class="video-prev" src={preview} muted loop playsinline preload="none" aria-hidden="true" />
							<span class="video-icon" aria-hidden="true" />
						</button>
						<figcaption>
							<img src={`/logos/${a.id}.webp`} alt="" width="28" height="28" loading="lazy" />
							{a.name}
						</figcaption>
					</figure>
				))
			}
		</div>
	</section>
	<div class="marquee" aria-hidden="true">
		{
			rows.map((row, r) => (
				<div class:list={['marquee-row', r === 1 && 'is-rev']}>
					{[...row, ...row].map((src) => (
						<img src={src} alt="" loading="lazy" />
					))}
				</div>
			))
		}
	</div>

	<!-- 04 · principles, over moonlit Ashenvale -->
	<section class="chapter vband" data-zone-src data-music="ashenvale">
		<video class="vband-bg" src="/media/bg/vallefresno-4.mp4" poster="/media/bg/vallefresno-4.webp" muted loop playsinline preload="none" aria-hidden="true" />
		<header class="sec-head">
			<p class="eyebrow"><i class="glyph" aria-hidden="true">&#x1F4D6;</i><span>04</span> / {w('Principles', 'Principios')}</p>
			<h2>{w('Forged the hard way.', 'Forjados a la antigua.')}</h2>
		</header>
		<ol class="principles">
			{
				principles.map(([h, p], i) => (
					<li>
						<img class="wow-icon" src={`/media/icons/${icons[i]}.png`} alt="" width="44" height="44" loading="lazy" />
						<h3>{h}</h3>
						<p>{p}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- 05 · install -->
	<section class="chapter" data-reveal>
		<header class="sec-head">
			<p class="eyebrow"><i class="glyph" aria-hidden="true">&#x1F528;</i><span>05</span> / {w('Install', 'Instalar')}</p>
			<h2>{w('Ready in three steps.', 'Listo en tres pasos.')}</h2>
		</header>
		<ol class="steps">
			<li>
				<strong>{w('Get the CurseForge app', 'Instala la app de CurseForge')}</strong>{' '}
				{w('and pick World of Warcraft and your game version.', 'y elige World of Warcraft y tu versión del juego.')}
			</li>
			<li>
				<strong>{w('Search the addon', 'Busca el addon')}</strong> {w('by name and click Install.', 'por su nombre y pulsa Instalar.')}
			</li>
			<li>
				<strong>{w('Log in to the game.', 'Entra al juego.')}</strong>{' '}
				{w('The app keeps the addon updated from then on.', 'La app mantiene el addon actualizado a partir de ahí.')}
			</li>
		</ol>
		<a class="btn btn-glass" href={href(lang, 'install')}>{w('Install by hand and fix common problems', 'Instalar a mano y resolver problemas')}</a>
	</section>

	<!-- closing band -->
	<section class="cta-band vband" data-zone-src data-music="orgrimmar">
		<video class="vband-bg" src="/media/bg/orgrimmar-2.mp4" poster="/media/bg/orgrimmar-2.webp" muted loop playsinline preload="none" aria-hidden="true" />
		<div class="cta-title">
			<i class="glyph" aria-hidden="true">&#x2694;</i>
			<h2>{w('Join the raid.', 'Únete a la banda.')}</h2>
			<i class="glyph" aria-hidden="true">&#x2694;</i>
		</div>
		<p>{w('Report a bug, ask for a feature or just say hi.', 'Avisa de un fallo, pide una función o simplemente saluda.')}</p>
		<div class="hx-actions">
			<a class="btn btn-gold" href="https://www.curseforge.com/members/pirson/projects" rel="noopener">CurseForge</a>
			<a class="btn btn-glass" href="https://github.com/Pirson-s-Addons" rel="noopener">GitHub</a>
		</div>
	</section>
</div>

<div class="sound" data-sound-box hidden>
	<button type="button" class="sound-btn" aria-pressed="false" data-sound>
		<span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
		<span>{w('Sound of Azeroth', 'Sonido de Azeroth')}</span>
	</button>
	<input type="range" class="sound-vol" min="0" max="100" value="12" aria-label={w('Music volume', 'Volumen de la música')} data-sound-vol />
</div>

<script>
	// era filter
	for (const cat of document.querySelectorAll<HTMLElement>('[data-catalog]')) {
		const bar = cat.querySelector<HTMLElement>('[data-filters]')!;
		const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
		const items = [...cat.querySelectorAll<HTMLElement>('[data-versions]')];
		bar.hidden = false;
		for (const b of buttons) {
			b.addEventListener('click', () => {
				for (const o of buttons) o.setAttribute('aria-pressed', String(o === b));
				const v = b.dataset.v!;
				for (const it of items) it.hidden = !!v && !it.dataset.versions!.split('|').includes(v);
			});
		}
	}
	// silent preview while the pointer or focus is on a video card
	for (const b of document.querySelectorAll<HTMLElement>('.video-play')) {
		const v = b.querySelector('video')!;
		const on = () => v.play().then(() => b.classList.add('is-previewing')).catch(() => {});
		const off = () => (b.classList.remove('is-previewing'), v.pause());
		b.addEventListener('pointerenter', on);
		b.addEventListener('focus', on);
		b.addEventListener('pointerleave', off);
		b.addEventListener('blur', off);
	}

	// background clips of the bands play only while on screen
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const bands = new IntersectionObserver((entries) => {
		for (const e of entries) {
			const v = e.target.querySelector('video')!;
			if (e.isIntersecting && !still) v.play().catch(() => {});
			else v.pause();
		}
	});
	document.querySelectorAll('.vband').forEach((b) => bands.observe(b));

	// zone music: two players cross-fade whenever the zone on screen changes
	const btn = document.querySelector<HTMLButtonElement>('[data-sound]')!;
	const zones = [...document.querySelectorAll<HTMLElement>('[data-zone-src]')];
	const players = [new Audio(), new Audio()];
	// background level: quiet by default (12%), the slider's value is remembered
	const slider = document.querySelector<HTMLInputElement>('[data-sound-vol]')!;
	let vol = Number(localStorage.getItem('pa-vol') ?? 12) / 100;
	slider.value = String(Math.round(vol * 100));
	let front = 0, track = '', enabled = localStorage.getItem('pa-sound') === '1';
	for (const p of players) {
		p.loop = true;
		p.preload = 'none';
		p.volume = 0;
	}
	const fade = (p: HTMLAudioElement, to: number, ms = 1600) => {
		const from = p.volume, t0 = performance.now();
		const step = (now: number) => {
			const k = Math.min(1, (now - t0) / ms);
			p.volume = from + (to - from) * k;
			if (k < 1) requestAnimationFrame(step);
			else if (to === 0) p.pause();
		};
		requestAnimationFrame(step);
	};
	// the zone whose block covers the middle of the screen; the hero until something else does
	const current = () => {
		const mid = innerHeight / 2;
		const z = zones.find((el) => {
			const r = el.getBoundingClientRect();
			return r.top <= mid && r.bottom >= mid;
		});
		return (z ?? zones[0]).dataset.music!;
	};
	const sync = () => {
		if (!enabled) return;
		const want = current();
		if (want === track) return;
		track = btn.dataset.track = want;
		fade(players[front], 0);
		front = 1 - front;
		const p = players[front];
		p.src = `/media/music/${want}.m4a`;
		p.play().then(() => fade(p, vol)).catch(() => {});
	};
	const show = () => {
		btn.setAttribute('aria-pressed', String(enabled));
		btn.parentElement!.classList.toggle('is-on', enabled);
	};
	btn.parentElement!.hidden = false;
	slider.addEventListener('input', () => {
		vol = Number(slider.value) / 100;
		localStorage.setItem('pa-vol', slider.value);
		if (enabled) players[front].volume = vol;
	});
	show();
	const silence = () => {
		enabled = false;
		show();
		players.forEach((p) => fade(p, 0, 600));
		track = '';
	};
	btn.addEventListener('click', () => {
		if (enabled) silence();
		else {
			enabled = true;
			show();
			sync();
		}
		localStorage.setItem('pa-sound', enabled ? '1' : '0');
	});
	addEventListener('scroll', sync, { passive: true });
	addEventListener('zone-change', sync);
	// browsers only start sound after a gesture: if it was left on, resume on the first one
	if (enabled) {
		const resume = () => {
			if (!enabled || !players[front].paused) return;
			track = '';
			sync();
		};
		addEventListener('pointerdown', resume, { once: true });
		addEventListener('keydown', resume, { once: true });
		sync();
	}

	// videos load only when played (no YouTube requests before that)
	for (const b of document.querySelectorAll<HTMLButtonElement>('[data-yt]')) {
		b.addEventListener('click', () => {
			silence(); // the video brings its own sound (the remembered choice stays as it was)
			const f = document.createElement('iframe');
			f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1`;
			f.title = b.getAttribute('aria-label')!;
			f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			b.replaceWith(f);
		});
	}
</script>
