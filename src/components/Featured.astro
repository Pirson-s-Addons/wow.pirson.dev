---
// Bento of WoW Forever addons that are not already in the hero deck: one large tile, four smaller,
// text over the art. `skip` = how many top addons the hero deck shows.
import addons from '../data/addons.json';
import { covers } from '../lib/covers';
import { t, href } from '../lib/i18n';

interface Props {
	lang: 'en' | 'es';
	skip?: number;
}
const { lang, skip = 3 } = Astro.props;
const l = lang === 'es' ? 1 : 0;
const inDeck = new Set(addons.filter((a) => covers[a.slug]).slice(0, skip).map((a) => a.id));
const list = addons
	.filter((a) => covers[a.slug] && !inDeck.has(a.id) && a.clients.some((c) => c[0] === 'WoW Forever'))
	.slice(0, 5);
---

<div class="bento not-content">
	{
		list.map((a, i) => (
			<a class:list={['tile', i === 0 && 'tile-big']} href={href(lang, `addons/${a.slug}`)} style={`--q:${a.color}`} data-tilt data-reveal>
				<img class="tile-art" src={covers[a.slug]} alt="" loading="lazy" />
				<span class="tile-shade" />
				<span class="tile-body">
					<span class="tile-head">
						<img src={`/logos/${a.id}.webp`} alt="" width="48" height="48" loading="lazy" />
						<span class="tile-name">{a.name}</span>
					</span>
					<span class="tile-text">{i === 0 ? a[lang] : a.one[l]}</span>
					<span class="tile-meta">
						{a.downloads.toLocaleString(lang)} {t(lang, 'downloads')}
					</span>
				</span>
				<span class="tcg-glare" aria-hidden="true" />
			</a>
		))
	}
</div>
