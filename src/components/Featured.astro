---
// The most used addons, one band each: screenshot on one side, what it does on the other, alternating.
import addons from '../data/addons.json';
import { covers } from '../lib/covers';
import { t, href } from '../lib/i18n';

interface Props {
	lang: 'en' | 'es';
	count?: number;
}
const { lang, count = 4 } = Astro.props;
const es = lang === 'es';
const l = es ? 1 : 0;
const list = addons.filter((a) => covers[a.slug]).slice(0, count);
---

<div class="featured not-content">
	{
		list.map((a, i) => (
			<article class:list={['feat', i % 2 === 1 && 'feat-flip']} style={`--q:${a.color}`} data-reveal>
				<a class="feat-media" href={href(lang, `addons/${a.slug}`)} tabindex="-1" aria-hidden="true">
					<img src={covers[a.slug]} alt="" loading="lazy" />
				</a>
				<div class="feat-body">
					<div class="feat-head">
						<img src={`/logos/${a.id}.webp`} alt="" width="56" height="56" loading="lazy" />
						<div>
							<h3>{a.name}</h3>
							<p class="feat-cat">{a.cat[l]}</p>
						</div>
					</div>
					<p class="feat-text">{a[lang]}</p>
					<ul class="chips">
						{a.clients.slice(0, 4).map((c) => <li>{c[l]}</li>)}
						{a.clients.length > 4 && <li>+{a.clients.length - 4}</li>}
					</ul>
					<p class="feat-dl">
						<strong>{a.downloads.toLocaleString(lang)}</strong> {t(lang, 'downloads')}
					</p>
					<div class="feat-actions">
						<a class="btn btn-gold" href={href(lang, `addons/${a.slug}`)}>
							{t(lang, 'guide')}
						</a>
						<a class="btn btn-ghost" href={a.url} rel="noopener">
							CurseForge
						</a>
					</div>
				</div>
			</article>
		))
	}
</div>
