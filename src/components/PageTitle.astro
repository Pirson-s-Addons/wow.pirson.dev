---
// Default Starlight title; on addon pages, the addon presented like an item tooltip
// (quality-coloured icon and name, game versions, category, downloads) with the download button.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import addons from '../data/addons.json';
import { t } from '../lib/i18n';

const { entry, lang } = Astro.locals.starlightRoute;
const addon = entry.data.addon ? addons.find((a) => a.id === entry.data.addon) : undefined;
const l = lang === 'es' ? 1 : 0;
---

{
	addon ? (
		<div class="addon-head" style={`--q:${addon.color}`}>
			<img class="item-icon" src={`/logos/${addon.id}.webp`} alt="" width="96" height="96" />
			<div class="wow-tooltip addon-tip">
				<Default />
				<span class="tt-white">{addon.clients.map((c) => c[l]).join(', ')}</span>
				<span class="tt-white">{addon.cat[l]}</span>
				<span class="tt-use">
					{lang === 'es' ? 'Uso: ' : 'Use: '}
					{addon.one[l]}
				</span>
				<span class="tt-gold">
					{addon.downloads.toLocaleString(lang)} {t(lang, 'downloads')}
					{addon.version && ` (v${addon.version})`}
				</span>
				<a class="wow-button" href={addon.url} rel="noopener">
					{t(lang, 'download')}
				</a>
			</div>
		</div>
	) : (
		<Default />
	)
}
