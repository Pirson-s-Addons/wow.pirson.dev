---
// Starlight's footer, then the site footer (top addons, help, disclaimer), the reading-progress
// experience bar, and the gentle reveal of home sections as they scroll in.
import Default from '@astrojs/starlight/components/Footer.astro';
import addons from '../data/addons.json';
import { href } from '../lib/i18n';

const { lang } = Astro.locals.starlightRoute;
const es = lang === 'es';
---

<Default />

<footer class="site-foot not-content">
	<div class="site-foot-brand">
		<p class="site-foot-name">Pirson's Addons</p>
		<p>
			{
				es
					? 'Addons hechos por un fan. Sin relación ni respaldo de Blizzard Entertainment. World of Warcraft y Warcraft son marcas de Blizzard Entertainment, Inc.'
					: 'Fan-made addons. Not affiliated with or endorsed by Blizzard Entertainment. World of Warcraft and Warcraft are trademarks of Blizzard Entertainment, Inc.'
			}
		</p>
	</div>
	<nav aria-label={es ? 'Addons más usados' : 'Most used addons'}>
		<p class="site-foot-head">Addons</p>
		<ul>
			{addons.slice(0, 6).map((a) => <li><a href={href(lang, `addons/${a.slug}`)}>{a.name}</a></li>)}
		</ul>
	</nav>
	<nav aria-label={es ? 'Ayuda' : 'Help'}>
		<p class="site-foot-head">{es ? 'Ayuda' : 'Help'}</p>
		<ul>
			<li><a href={href(lang, 'install')}>{es ? 'Cómo instalar addons' : 'How to install addons'}</a></li>
			<li><a href={es ? '/es/blog/' : '/blog/'}>Blog</a></li>
			<li><a href="https://www.curseforge.com/members/pirson/projects" rel="noopener">CurseForge</a></li>
			<li><a href="https://github.com/Pirson-s-Addons" rel="noopener">GitHub</a></li>
		</ul>
	</nav>
</footer>

<div class="xp-bar" aria-hidden="true"><span data-xp></span></div>

<script>
	const fill = document.querySelector<HTMLElement>('[data-xp]');
	if (fill) {
		const update = () => {
			const max = document.documentElement.scrollHeight - innerHeight;
			fill.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
		};
		addEventListener('scroll', update, { passive: true });
		addEventListener('resize', update);
		update();
	}

	// Cards tilt toward the pointer with a moving glare; numbers count up when they come into view.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(hover: hover)').matches) {
		for (const el of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
			el.addEventListener('pointermove', (e) => {
				const r = el.getBoundingClientRect();
				const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
				el.style.setProperty('--rx', `${(0.5 - y) * 10}deg`);
				el.style.setProperty('--ry', `${(x - 0.5) * 12}deg`);
				el.style.setProperty('--gx', `${x * 100}%`);
				el.style.setProperty('--gy', `${y * 100}%`);
			});
			el.addEventListener('pointerleave', () => {
				el.style.removeProperty('--rx');
				el.style.removeProperty('--ry');
			});
		}
		const nums = document.querySelectorAll<HTMLElement>('[data-count]');
		const fmt = new Intl.NumberFormat(document.documentElement.lang);
		const count = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				count.unobserve(e.target);
				const el = e.target as HTMLElement, end = Number(el.dataset.count), t0 = performance.now();
				const step = (now: number) => {
					const p = Math.min(1, (now - t0) / 1400);
					el.textContent = fmt.format(Math.round(end * (1 - Math.pow(1 - p, 3))));
					if (p < 1) requestAnimationFrame(step);
				};
				requestAnimationFrame(step);
			}
		});
		nums.forEach((n) => count.observe(n));
	}

	// Home sections rise in once as they enter the screen (nothing to do with reduced motion).
	const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
	if (items.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					e.target.classList.add('is-in');
					io.unobserve(e.target);
				}
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		items.forEach((el, i) => {
			el.style.setProperty('--d', `${(i % 3) * 70}ms`);
			el.classList.add('will-reveal');
			io.observe(el);
		});
	}
</script>
