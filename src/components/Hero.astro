---
// Pages with a hero: the home gets the card deck, addon guides the store-page header (their hero
// comes from src/routeData.ts), any other full-width page (install…) a compact header.
import HomeDeck from './HomeDeck.astro';
import AddonHero from './AddonHero.astro';

const PAGE_TITLE_ID = '_top'; // Starlight's page title id (not exported)
const { entry, id } = Astro.locals.starlightRoute;
const home = ['', 'index', 'es', 'es/index'].includes(id);
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero || {};
---

{
	home ? (
		<HomeDeck />
	) : entry.data.addon ? (
		<AddonHero />
	) : (
		<header class="ph">
			<h1 id={PAGE_TITLE_ID} data-page-title class="ph-title" set:html={title} />
			{tagline && <p class="ph-tagline" set:html={tagline} />}
			{actions.length > 0 && (
				<div class="hx-actions">
					{actions.map(({ link, text, variant }) => (
						<a href={link} class:list={['btn', variant === 'minimal' ? 'btn-glass' : 'btn-gold']}>
							{text}
						</a>
					))}
				</div>
			)}
		</header>
	)
}
