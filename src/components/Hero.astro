---
// Home hero: the character select screen. Each addon stands on the pedestal like a character;
// the list on the right is the character list, the realm picker filters by game version and
// "Enter world" opens the addon's guide. Without JavaScript it shows the most downloaded addon
// and every list entry is a plain link.
import addons from '../data/addons.json';
import Hall from './Hall.astro';
import { t, href } from '../lib/i18n';

const PAGE_TITLE_ID = '_top'; // Starlight's page title id (not exported)
const { entry, lang } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline } = entry.data.hero || {};
const es = lang === 'es';
const l = es ? 1 : 0;
const total = addons.reduce((s, a) => s + a.downloads, 0);

const data = addons.map((a) => ({
	id: a.id,
	name: a.name,
	color: a.color,
	cat: a.cat[l],
	one: a.one[l],
	clients: a.clients.map((c) => c[l]),
	downloads: a.downloads.toLocaleString(lang),
	guide: href(lang, `addons/${a.slug}`),
	url: a.url,
}));
const first = data[0];
// "WoW Forever, MoP Classic +5": the class line of the character list stays one line
const short = (c: string[]) => (c.length > 2 ? `${c.slice(0, 2).join(', ')} +${c.length - 2}` : c.join(', '));
const realms = [...new Set(data.flatMap((a) => a.clients))];

// 24 runes around the pedestal, each a few strokes from a fixed seed so the build is stable.
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const runes = Array.from({ length: 24 }, (_, i) => {
	const strokes = Array.from({ length: 2 + Math.floor(rnd() * 2) }, () => {
		const x1 = Math.round(rnd() * 8 - 4), y1 = Math.round(rnd() * 10 - 5);
		const x2 = Math.round(rnd() * 8 - 4), y2 = Math.round(rnd() * 10 - 5);
		return `M${x1} ${y1}L${x2} ${y2}`;
	});
	return { d: `M0 -6V6${strokes.join('')}`, deg: i * 15 };
});
---

<section class="cs" data-cs data-intro>
	<div class="cs-hall" data-cs-hall><Hall room="heroes" /></div>
	<div class="cs-fog cs-fog-1" aria-hidden="true"></div>
	<div class="cs-fog cs-fog-2" aria-hidden="true"></div>
	<canvas class="cs-motes" aria-hidden="true"></canvas>

	<header class="cs-title">
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{tagline && <p set:html={tagline} />}
	</header>

	<label class="cs-realm">
		<span>{es ? 'Reino' : 'Realm'}</span>
		<select data-cs-realm>
			<option value="">{es ? 'Todos' : 'All'}</option>
			{realms.map((r) => <option value={r}>{r}</option>)}
		</select>
	</label>

	<div class="cs-stage" style={`--q:${first.color}`} data-cs-stage>
		<div class="cs-light" aria-hidden="true"></div>
		<button class="cs-arrow cs-prev" type="button" data-cs-step="-1" aria-label={es ? 'Addon anterior' : 'Previous addon'}>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
		</button>
		<div class="cs-model" data-cs-model>
			<img src={`/logos/${first.id}.webp`} alt="" width="192" height="192" data-cs-img />
		</div>
		<div class="cs-pedestal" aria-hidden="true">
			<svg class="cs-runes" viewBox="-110 -110 220 220">
				<circle r="98" class="cs-ring" />
				<circle r="78" class="cs-ring cs-ring-thin" />
				{
					runes.map((r, i) => (
						<path d={r.d} transform={`rotate(${r.deg}) translate(0 -88)`} style={`--i:${i}`} />
					))
				}
			</svg>
			<div class="cs-stone"></div>
		</div>
		<button class="cs-arrow cs-next" type="button" data-cs-step="1" aria-label={es ? 'Siguiente addon' : 'Next addon'}>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg>
		</button>
	</div>

	<div class="cs-info" aria-live="polite" style={`--q:${first.color}`} data-cs-info>
		<p class="cs-name" data-cs-name>{first.name}</p>
		<p class="cs-class" data-cs-class>{first.cat}, {short(first.clients)}</p>
		<p class="cs-use" data-cs-use>{es ? 'Uso: ' : 'Use: '}{first.one}</p>
		<p class="cs-dl"><span data-cs-dl>{first.downloads}</span> {t(lang, 'downloads')}</p>
	</div>

	<nav class="cs-list" aria-label={es ? 'Addons' : 'Addons'}>
		<p class="cs-list-head">
			<strong>{data.length}</strong> addons, <strong>{total.toLocaleString(lang)}</strong> {t(lang, 'downloads')}
		</p>
		<ul data-cs-list>
			{
				data.map((a, i) => (
					<li data-realms={a.clients.join('|')} style={`--q:${a.color}`}>
						<a href={a.guide} data-cs-index={i} aria-current={i === 0 ? 'true' : undefined}>
							<img src={`/logos/${a.id}.webp`} alt="" width="40" height="40" loading="lazy" />
							<span class="n">{a.name}</span>
							<span class="c">{a.cat}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="cs-actions">
		<a class="wow-button cs-enter" href={first.guide} data-cs-enter>
			{es ? 'Entrar al mundo' : 'Enter world'}
		</a>
		<a class="cs-download" href={first.url} rel="noopener" data-cs-download>
			{t(lang, 'download')}
		</a>
	</div>

	<script type="application/json" data-cs-data set:html={JSON.stringify({ addons: data, use: es ? 'Uso: ' : 'Use: ' })} />
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-cs]');
	if (root) {
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const { addons, use } = JSON.parse(root.querySelector('[data-cs-data]')!.textContent!);
		const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
		const stage = $('[data-cs-stage]'), info = $('[data-cs-info]'), model = $('[data-cs-model]');
		const img = $<HTMLImageElement>('[data-cs-img]');
		const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-cs-index]')];
		let current = 0;
		let visible = links.map((_, i) => i);

		const show = (i: number, dir = 1) => {
			if (i === current) return;
			const a = addons[i];
			const swap = () => {
				img.src = `/logos/${a.id}.webp`;
				$('[data-cs-name]').textContent = a.name;
				$('[data-cs-class]').textContent = `${a.cat}, ${a.clients.length > 2 ? `${a.clients.slice(0, 2).join(', ')} +${a.clients.length - 2}` : a.clients.join(', ')}`;
				$('[data-cs-use]').textContent = use + a.one;
				$('[data-cs-dl]').textContent = a.downloads;
				$<HTMLAnchorElement>('[data-cs-enter]').href = a.guide;
				$<HTMLAnchorElement>('[data-cs-download]').href = a.url;
				for (const el of [stage, info]) el.style.setProperty('--q', a.color);
			};
			links[current].removeAttribute('aria-current');
			links[i].setAttribute('aria-current', 'true');
			links[i].scrollIntoView({ block: 'nearest', behavior: still ? 'auto' : 'smooth' });
			current = i;
			if (still) return swap();
			model.style.setProperty('--dir', String(dir));
			model.classList.remove('is-in');
			model.classList.add('is-out');
			stage.classList.remove('is-flash');
			setTimeout(() => {
				swap();
				model.classList.remove('is-out');
				void model.offsetWidth; // restart the entrance
				model.classList.add('is-in');
				stage.classList.add('is-flash');
			}, 260);
		};
		const step = (d: number) => {
			const pos = visible.indexOf(current);
			const next = visible[(pos + d + visible.length) % visible.length];
			show(next, d);
		};

		// The list behaves like the character list: click selects, double click (or Enter) enters.
		for (const a of links) {
			a.addEventListener('click', (e) => {
				const i = Number(a.dataset.csIndex);
				if (i !== current) {
					e.preventDefault();
					show(i, i > current ? 1 : -1);
				}
			});
			a.addEventListener('dblclick', () => (location.href = a.href));
		}
		root.querySelectorAll<HTMLButtonElement>('[data-cs-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.csStep))));
		root.addEventListener('keydown', (e) => {
			if ((e.target as HTMLElement).tagName === 'SELECT') return;
			if (e.key === 'ArrowRight' || e.key === 'ArrowDown') (e.preventDefault(), step(1));
			if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') (e.preventDefault(), step(-1));
		});
		let touchX = 0;
		stage.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
		stage.addEventListener('touchend', (e) => {
			const dx = e.changedTouches[0].clientX - touchX;
			if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
		});

		// Realm picker: show only the addons for that game version.
		$<HTMLSelectElement>('[data-cs-realm]').addEventListener('change', (e) => {
			const realm = (e.target as HTMLSelectElement).value;
			visible = [];
			links.forEach((a, i) => {
				const ok = !realm || a.parentElement!.dataset.realms!.split('|').includes(realm);
				a.parentElement!.hidden = !ok;
				if (ok) visible.push(i);
			});
			if (!visible.includes(current)) show(visible[0]);
		});

		// Intro runs once per visit; reduced motion skips straight to the final scene.
		if (still || sessionStorage.getItem('cs-intro')) root.removeAttribute('data-intro');
		else {
			sessionStorage.setItem('cs-intro', '1');
			root.classList.add('is-playing');
			const end = () => root.removeAttribute('data-intro');
			setTimeout(end, 2400);
			addEventListener('keydown', end, { once: true });
			root.addEventListener('pointerdown', end, { once: true });
		}

		// The hall sways with the pointer: far layers move less than near ones.
		if (!still) {
			const layers = [...root.querySelectorAll<SVGGElement>('[data-cs-hall] [data-depth]')];
			root.addEventListener('pointermove', (e) => {
				const dx = e.clientX / innerWidth - 0.5, dy = e.clientY / innerHeight - 0.5;
				for (const g of layers) {
					const d = Number(g.dataset.depth);
					g.style.transform = `translate(${-dx * 40 * d}px, ${-dy * 18 * d}px)`;
				}
			});
		}

		// Rising motes in the addon's quality colour.
		if (!still) {
			const canvas = $<HTMLCanvasElement>('.cs-motes');
			const ctx = canvas.getContext('2d')!;
			let on = true;
			new IntersectionObserver(([e]) => (on = e.isIntersecting)).observe(root);
			const size = () => {
				canvas.width = root.clientWidth * devicePixelRatio;
				canvas.height = root.clientHeight * devicePixelRatio;
			};
			size();
			addEventListener('resize', size);
			const motes = Array.from({ length: 40 }, () => ({ x: 0.3 + Math.random() * 0.4, y: Math.random(), s: 0.5 + Math.random() * 1.6, v: 0.0008 + Math.random() * 0.0016, d: Math.random() * 6.28 }));
			const tick = (time: number) => {
				if (on && !document.hidden) {
					ctx.clearRect(0, 0, canvas.width, canvas.height);
					ctx.fillStyle = getComputedStyle(stage).getPropertyValue('--q') || '#7fd6ff';
					for (const p of motes) {
						p.y -= p.v;
						if (p.y < 0.1) Object.assign(p, { y: 0.85, x: 0.32 + Math.random() * 0.36 });
						ctx.globalAlpha = Math.min(1, (p.y - 0.1) * 3) * (0.3 + 0.3 * Math.sin(time / 350 + p.d));
						ctx.beginPath();
						ctx.arc((p.x + Math.sin(time / 1500 + p.d) * 0.01) * canvas.width, p.y * canvas.height, p.s * devicePixelRatio, 0, 6.28);
						ctx.fill();
					}
				}
				requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		}
	}
</script>

<style>
	/* Character select. Cold stone and fog; the selected addon's quality colour (--q) lights the
	   runes, the light cone, the motes and the model's glow. */
	.cs {
		--abyss: #070d14;
		--fog: #4f6d86;
		--frame: #c9a24a;
		--q: #7fd6ff;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		margin-inline: calc(50% - 50vw);
		margin-top: calc(-1 * var(--sl-content-pad-y, 2rem));
		min-height: max(40rem, min(54rem, 100svh - var(--sl-nav-height)));
		display: grid;
		grid-template-columns: minmax(16rem, 22rem) 1fr minmax(16rem, 21rem);
		grid-template-rows: auto 1fr auto;
		grid-template-areas:
			'title realm list'
			'info  stage list'
			'.     actions list';
		gap: 1rem 2rem;
		padding: 2rem clamp(1rem, 3vw, 3rem) 2.5rem;
		color: #e9edf2;
		background: var(--abyss);
	}

	/* drifting fog banks */
	.cs-fog {
		position: absolute;
		inset: -10% -30%;
		z-index: -2;
		pointer-events: none;
		background:
			radial-gradient(28% 18% at 20% 62%, rgb(110 140 170 / 0.22), transparent 70%),
			radial-gradient(30% 16% at 70% 72%, rgb(110 140 170 / 0.2), transparent 70%),
			radial-gradient(22% 12% at 45% 80%, rgb(140 170 200 / 0.18), transparent 70%);
		filter: blur(8px);
		animation: cs-drift 60s linear infinite alternate;
	}
	.cs-fog-2 {
		inset: 0 -40%;
		opacity: 0.8;
		animation-duration: 90s;
		animation-direction: alternate-reverse;
	}
	@keyframes cs-drift {
		to {
			transform: translateX(18%);
		}
	}

	.cs-hall {
		position: absolute;
		inset: -3%;
		z-index: -3;
	}
	.cs-motes {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}

	.cs-title {
		grid-area: title;
	}
	.cs-title h1 {
		margin: 0;
		font-size: clamp(2.2rem, 4vw, 3.4rem);
		line-height: 1;
		color: var(--gold-bright);
		text-shadow:
			0 2px 0 #3d2a00,
			0 0 28px rgb(255 209 0 / 0.3);
	}
	.cs-title p {
		margin: 0.75rem 0 0;
		max-width: 26rem;
		color: #b9c4d0;
		line-height: 1.5;
	}

	.cs-realm {
		grid-area: realm;
		justify-self: center;
		align-self: start;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0.5rem 0.4rem 0.9rem;
		font-family: var(--display);
		color: var(--gold-bright);
		background: rgb(4 8 14 / 0.7);
		border: 1px solid var(--frame);
		border-radius: 4px;
	}
	.cs-realm select {
		font: inherit;
		color: #fff;
		background: #0e1824;
		border: 1px solid #45566a;
		border-radius: 3px;
		padding: 0.25rem 0.5rem;
	}

	/* ---------- stage: light, model, pedestal ---------- */
	.cs-stage {
		grid-area: stage;
		position: relative;
		display: grid;
		place-items: center;
		min-height: 26rem;
	}
	.cs-light {
		position: absolute;
		top: -30%;
		left: 50%;
		width: 26rem;
		height: 120%;
		translate: -50% 0;
		background: linear-gradient(color-mix(in srgb, var(--q) 30%, transparent), transparent 80%);
		clip-path: polygon(42% 0, 58% 0, 100% 100%, 0 100%);
		filter: blur(18px);
		opacity: 0.55;
		transition: background 0.6s;
		pointer-events: none;
	}
	.cs-model {
		position: relative;
		z-index: 2;
		margin-top: 6rem;
		animation: cs-bob 4.5s ease-in-out infinite;
	}
	.cs-model img {
		display: block;
		width: clamp(9rem, 16vw, 12.5rem);
		height: auto;
		filter: drop-shadow(0 0 22px color-mix(in srgb, var(--q) 70%, transparent)) drop-shadow(0 12px 18px rgb(0 0 0 / 0.6));
	}
	@keyframes cs-bob {
		50% {
			translate: 0 -10px;
		}
	}
	/* the camera turns: out to one side, in from the other */
	.cs-model.is-out img {
		transition:
			transform 0.26s ease-in,
			opacity 0.26s ease-in;
		transform: perspective(700px) rotateY(calc(var(--dir, 1) * -75deg)) translateX(calc(var(--dir, 1) * -30%));
		opacity: 0;
	}
	.cs-model.is-in img {
		animation: cs-enter 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	@keyframes cs-enter {
		from {
			transform: perspective(700px) rotateY(calc(var(--dir, 1) * 75deg)) translateX(calc(var(--dir, 1) * 30%));
			opacity: 0;
			filter: brightness(2.2) blur(6px);
		}
	}
	.cs-stage.is-flash .cs-runes {
		animation: cs-flash 0.7s ease-out;
	}
	@keyframes cs-flash {
		30% {
			filter: drop-shadow(0 0 18px var(--q)) brightness(1.8);
		}
	}

	.cs-pedestal {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		translate: -50% 0;
		width: clamp(16rem, 28vw, 22rem);
		aspect-ratio: 1 / 0.42;
	}
	.cs-stone {
		position: absolute;
		inset: 18% 0 0;
		border-radius: 50% / 38%;
		background:
			radial-gradient(50% 42% at 50% 30%, #5b6876, #2c3642 70%, transparent 71%),
			linear-gradient(#2c3642 40%, #141b23);
		box-shadow:
			0 18px 40px rgb(0 0 0 / 0.7),
			inset 0 -10px 20px rgb(0 0 0 / 0.5);
		z-index: -1;
	}
	.cs-runes {
		position: absolute;
		left: 0;
		top: -38%;
		width: 100%;
		transform: scaleY(0.36);
		overflow: visible;
		filter: drop-shadow(0 0 6px var(--q));
		transition: filter 0.6s;
	}
	.cs-runes :is(circle, path) {
		fill: none;
		stroke: var(--q);
		stroke-width: 2.2;
		stroke-linecap: round;
		transition: stroke 0.6s;
	}
	.cs-ring-thin {
		stroke-width: 1 !important;
		opacity: 0.6;
	}
	.cs-runes path {
		animation: cs-rune-pulse 3s ease-in-out infinite;
		animation-delay: calc(var(--i) * 0.125s);
	}
	@keyframes cs-rune-pulse {
		50% {
			opacity: 0.45;
		}
	}

	.cs-arrow {
		position: absolute;
		z-index: 3;
		top: 30%;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		color: var(--gold-bright);
		background: rgb(4 8 14 / 0.6);
		border: 1px solid var(--frame);
		border-radius: 50%;
		cursor: pointer;
	}
	.cs-arrow:hover {
		background: rgb(30 44 60 / 0.85);
	}
	.cs-arrow svg {
		width: 1.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
	}
	.cs-prev {
		left: 0;
	}
	.cs-next {
		right: 0;
	}

	/* ---------- left: the selected addon ---------- */
	.cs-info {
		grid-area: info;
		align-self: center;
		padding: 1rem 1.2rem;
		background: linear-gradient(rgb(14 22 34 / 0.85), rgb(6 10 16 / 0.85));
		border: 1px solid #45566a;
		border-left: 3px solid var(--q);
		border-radius: 4px;
		transition: border-color 0.6s;
	}
	.cs-info p {
		margin: 0;
	}
	.cs-name {
		font-family: var(--display);
		font-size: 1.7rem;
		line-height: 1.1;
		color: var(--q);
		transition: color 0.6s;
	}
	.cs-class {
		margin-top: 0.35rem !important;
		color: #c9d2dc;
	}
	.cs-use {
		margin-top: 0.6rem !important;
		color: var(--use-green);
	}
	.cs-dl {
		margin-top: 0.6rem !important;
		color: var(--gold-bright);
	}

	/* ---------- right: the character list ---------- */
	.cs-list {
		grid-area: list;
		align-self: stretch;
		display: flex;
		flex-direction: column;
		min-height: 0;
		max-height: 46rem;
		background: linear-gradient(rgb(14 22 34 / 0.9), rgb(6 10 16 / 0.9));
		border: 1px solid var(--frame);
		border-radius: 5px;
		box-shadow:
			inset 0 0 0 1px #000,
			0 10px 30px rgb(0 0 0 / 0.5);
	}
	.cs-list-head {
		margin: 0;
		padding: 0.7rem 1rem;
		font-size: 0.92rem;
		color: #b9c4d0;
		border-bottom: 1px solid #2c3a4a;
	}
	.cs-list-head strong {
		color: #fff;
	}
	.cs-list ul {
		list-style: none;
		margin: 0;
		padding: 0.35rem;
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: #45566a transparent;
	}
	.cs-list a {
		display: grid;
		grid-template-columns: 40px 1fr;
		column-gap: 0.7rem;
		align-items: center;
		padding: 0.4rem 0.55rem;
		border: 1px solid transparent;
		border-radius: 3px;
		text-decoration: none;
	}
	.cs-list img {
		grid-row: span 2;
		border-radius: 50%;
		box-shadow: 0 0 0 1px #000;
	}
	.cs-list .n {
		font-family: var(--display);
		color: var(--gold-bright);
		line-height: 1.15;
	}
	.cs-list .c {
