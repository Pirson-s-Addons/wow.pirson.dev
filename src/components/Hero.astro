---
// Home hero: a deck of collectible cards (the most used addons, with their real art) over a blurred,
// parallax backdrop of the card in front. The deck turns every few seconds, fans out on hover and a
// click on a back card brings it forward. Under it, a glass bar with the numbers.
import addons from '../data/addons.json';
import { covers } from '../lib/covers';
import { t, href } from '../lib/i18n';

const PAGE_TITLE_ID = '_top'; // Starlight's page title id (not exported)
const { entry, lang } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero || {};
const es = lang === 'es';
const l = es ? 1 : 0;
const total = addons.reduce((s, a) => s + a.downloads, 0);
const versions = new Set(addons.flatMap((a) => a.clients.map((c) => c[0]))).size;
const deck = addons.filter((a) => covers[a.slug]).slice(0, 3);
---

<section class="hx" data-hx>
	<div class="hx-bg" aria-hidden="true" data-hx-bg>
		{deck.map((a, i) => <img src={covers[a.slug]} alt="" class:list={[i === 0 && 'is-on']} />)}
	</div>

	<div class="hx-inner">
		<div class="hx-copy">
			<h1 id={PAGE_TITLE_ID} data-page-title class="hx-title" set:html={title} />
			{tagline && <p class="hx-tagline" set:html={tagline} />}
			<div class="hx-actions">
				{
					actions.map(({ link, text, variant }) => (
						<a href={link} class:list={['btn', variant === 'minimal' ? 'btn-glass' : 'btn-gold']}>
							{text}
						</a>
					))
				}
			</div>
		</div>

		<div class="deck" data-deck aria-label={es ? 'Addons destacados' : 'Featured addons'} role="group">
			{
				deck.map((a, i) => (
					<a class="tcg" href={href(lang, `addons/${a.slug}`)} style={`--q:${a.color}`} data-pos={i} data-tilt>
						<span class="tcg-art">
							<img src={covers[a.slug]} alt="" loading="eager" />
						</span>
						<span class="tcg-body">
							<img class="tcg-logo" src={`/logos/${a.id}.webp`} alt="" width="64" height="64" />
							<span class="tcg-name">{a.name}</span>
							<span class="tcg-one">{a.one[l]}</span>
							<span class="tcg-foot">
								<span>{a.cat[l]}</span>
								<span>{a.downloads.toLocaleString(lang)}</span>
							</span>
						</span>
						<span class="tcg-glare" aria-hidden="true" />
					</a>
				))
			}
		</div>
	</div>

	<dl class="hx-stats glass">
		<div><dd data-count={total}>{total.toLocaleString(lang)}</dd><dt>{t(lang, 'downloads')}</dt></div>
		<div><dd data-count={addons.length}>{addons.length}</dd><dt>Addons</dt></div>
		<div><dd data-count={versions}>{versions}</dd><dt>{es ? 'versiones del juego' : 'game versions'}</dt></div>
	</dl>
</section>

<script>
	const hx = document.querySelector<HTMLElement>('[data-hx]');
	if (hx) {
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const deck = hx.querySelector<HTMLElement>('[data-deck]')!;
		const cards = [...deck.querySelectorAll<HTMLElement>('.tcg')];
		const bgs = [...hx.querySelectorAll<HTMLImageElement>('[data-hx-bg] img')];
		let order = cards.map((_, i) => i); // order[0] is the card in front

		const layout = () => {
			order.forEach((c, pos) => {
				cards[c].dataset.pos = String(pos);
				cards[c].tabIndex = pos === 0 ? 0 : -1;
			});
			bgs.forEach((b, i) => b.classList.toggle('is-on', i === order[0]));
		};
		const bringFront = (c: number) => {
			order = [c, ...order.filter((x) => x !== c)];
			layout();
		};
		cards.forEach((card, c) =>
			card.addEventListener('click', (e) => {
				if (order[0] !== c) {
					e.preventDefault();
					bringFront(c);
				}
			}),
		);
		layout();

		if (!still) {
			let paused = false;
			deck.addEventListener('pointerenter', () => (paused = true));
			deck.addEventListener('pointerleave', () => (paused = false));
			deck.addEventListener('focusin', () => (paused = true));
			setInterval(() => {
				if (paused || document.hidden) return;
				order = [...order.slice(1), order[0]];
				layout();
			}, 5000);

			// backdrop drifts slower than the page
			const bg = hx.querySelector<HTMLElement>('[data-hx-bg]')!;
			addEventListener('scroll', () => scrollY < innerHeight && (bg.style.transform = `translate3d(0, ${scrollY * 0.35}px, 0) scale(1.15)`), { passive: true });
		}
	}
</script>
