---
// Home hero: who this is and what to do, next to a showcase of real screenshots of the most used
// addons that crossfades every few seconds (paused on hover, still with reduced motion).
import addons from '../data/addons.json';
import { covers } from '../lib/covers';
import { t, href } from '../lib/i18n';

const PAGE_TITLE_ID = '_top'; // Starlight's page title id (not exported)
const { entry, lang } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero || {};
const es = lang === 'es';
const l = es ? 1 : 0;
const total = addons.reduce((s, a) => s + a.downloads, 0);
const forever = addons.filter((a) => a.clients.some((c) => c[0] === 'WoW Forever')).length;
const shows = addons.filter((a) => covers[a.slug]).slice(0, 5);
---

<section class="hero-x" data-hero>
	<div class="hero-copy">
		<p class="hero-kicker">{es ? 'Addons de World of Warcraft' : 'World of Warcraft addons'}</p>
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{tagline && <p class="hero-tagline" set:html={tagline} />}
		<div class="hero-actions">
			{
				actions.map(({ link, text, variant }) => (
					<a href={link} class:list={['btn', variant === 'minimal' ? 'btn-ghost' : 'btn-gold']}>
						{text}
					</a>
				))
			}
		</div>
		<dl class="hero-stats">
			<div><dt>{t(lang, 'downloads')}</dt><dd>{total.toLocaleString(lang)}</dd></div>
			<div><dt>Addons</dt><dd>{addons.length}</dd></div>
			<div><dt>{es ? 'Para WoW Forever' : 'For WoW Forever'}</dt><dd>{forever}</dd></div>
		</dl>
	</div>

	<div class="hero-show" data-show>
		<div class="hero-frame">
			{
				shows.map((a, i) => (
					<a class:list={['hero-slide', i === 0 && 'is-on']} href={href(lang, `addons/${a.slug}`)} tabindex={i === 0 ? 0 : -1} aria-hidden={i === 0 ? undefined : 'true'}>
						<img src={covers[a.slug]} alt={`${a.name}: ${a.one[l]}`} loading={i === 0 ? 'eager' : 'lazy'} />
						<span class="hero-cap" style={`--q:${a.color}`}>
							<img src={`/logos/${a.id}.webp`} alt="" width="40" height="40" />
							<span>
								<strong>{a.name}</strong>
								<span>{a.one[l]}</span>
							</span>
						</span>
					</a>
				))
			}
		</div>
		<ol class="hero-dots" aria-label={es ? 'Elegir captura' : 'Choose screenshot'}>
			{
				shows.map((a, i) => (
					<li>
						<button type="button" data-dot={i} aria-label={a.name} aria-current={i === 0 ? 'true' : undefined} />
					</li>
				))
			}
		</ol>
		<img class="hero-badge" src={`/logos/${shows[0].id}.webp`} alt="" width="120" height="120" data-badge />
	</div>
</section>

<script>
	const show = document.querySelector<HTMLElement>('[data-show]');
	if (show) {
		const slides = [...show.querySelectorAll<HTMLAnchorElement>('.hero-slide')];
		const dots = [...show.querySelectorAll<HTMLButtonElement>('[data-dot]')];
		const badge = show.querySelector<HTMLImageElement>('[data-badge]')!;
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let i = 0;
		const go = (n: number) => {
			slides[i].classList.remove('is-on');
			slides[i].tabIndex = -1;
			slides[i].setAttribute('aria-hidden', 'true');
			dots[i].removeAttribute('aria-current');
			i = (n + slides.length) % slides.length;
			slides[i].classList.add('is-on');
			slides[i].tabIndex = 0;
			slides[i].removeAttribute('aria-hidden');
			dots[i].setAttribute('aria-current', 'true');
			badge.src = slides[i].querySelector<HTMLImageElement>('.hero-cap img')!.src;
		};
		dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
		if (!still) {
			let paused = false;
			show.addEventListener('pointerenter', () => (paused = true));
			show.addEventListener('pointerleave', () => (paused = false));
			show.addEventListener('focusin', () => (paused = true));
			setInterval(() => !paused && !document.hidden && go(i + 1), 6000);
			// the badge floats a little against the pointer
			show.addEventListener('pointermove', (e) => {
				const r = show.getBoundingClientRect();
				badge.style.translate = `${((e.clientX - r.left) / r.width - 0.5) * -14}px ${((e.clientY - r.top) / r.height - 0.5) * -14}px`;
			});
		}
	}
</script>
