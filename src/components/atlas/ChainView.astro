---
// A quest chain: every step in order with its level, where it starts and its rewards.
import { T, fmt, wow, type Lang } from '../../lib/atlas/i18n';
import { addon, questName, href, L } from '../../lib/atlas/data';
import { place } from '../../lib/atlas/view';
import ItemLink from './ItemLink.astro';
import Faction from './Faction.astro';

interface Props {
	lang: Lang;
	steps: number[];
}
const { lang, steps } = Astro.props;
const t = T[lang];
---

<section class="atlas-hero">
	<h1>{questName(lang, steps.at(-1)!)}</h1>
	<p class="meta">{L(lang, 'CHAIN_PART')} · {fmt(t.chainSteps, steps.length)}</p>
</section>

<ol class="page chain-full">
	{
		steps.map((id) => {
			const q = addon.Quests[id] ?? {};
			const from = (q.starts ?? []).map((k) => place(lang, k));
			return (
				<li>
					<h2>
						<a href={href(lang, { kind: 'quest', id })}>{questName(lang, id)}</a>
						{q.level && <small>{wow(L(lang, 'LEVEL'))} {q.level}</small>}
						<Faction lang={lang} faction={q.faction} />
					</h2>
					{from.length > 0 && (
						<p class="meta">
							{wow(L(lang, 'STARTS'))} {from.map((p) => p.name).join(', ')}
							{from[0].where && <small> · {from[0].where}</small>}
						</p>
					)}
					{!!(q.choice?.length || q.rewards?.length) && (
						<ul class="loot">
							{[...(q.choice ?? []), ...(q.rewards ?? [])].map((i) => (
								<li>
									<ItemLink lang={lang} id={i} />
								</li>
							))}
						</ul>
					)}
				</li>
			);
		})
	}
</ol>
