---
// A world event of the Traveler's Log: when it runs and all its quests.
import { T2, fmt, LANG, type Lang } from '../../lib/atlas/i18n';
import { addon, eventName, eventQuests, L, type GameEvent } from '../../lib/atlas/data';
import QuestRow from './QuestRow.astro';
import ItemLink from './ItemLink.astro';

interface Props {
	lang: Lang;
	e: GameEvent;
}
const { lang, e } = Astro.props;
const t = T2[lang];
const days = e.hours ? Math.round(e.hours / 24) : undefined;
// fallback dates, approximate, as in the addon (the game's calendar has the exact ones)
const when = (() => {
	const f = new Intl.DateTimeFormat(LANG[lang].html, { day: 'numeric', month: 'long' });
	if (e.yearly) return fmt(t.yearly, f.format(new Date(Date.UTC(2027, e.yearly[0] - 1, e.yearly[1]))), days ?? '?');
	if (e.monthly) return fmt(t.monthly, days ?? 7);
	if (e.dates?.length) {
		const g = new Intl.DateTimeFormat(LANG[lang].html, { dateStyle: 'long' });
		const next = e.dates.find(([, end]) => new Date(end) > new Date()) ?? e.dates.at(-1)!;
		return `${g.format(new Date(next[0]))} – ${g.format(new Date(next[1]))}`;
	}
	return '';
})();
const quests = eventQuests(e).sort((a, b) => (addon.Quests[a].level ?? 0) - (addon.Quests[b].level ?? 0));
---

<section class="atlas-hero">
	<h1>{eventName(lang, e)}</h1>
	<p class="meta">{L(lang, 'TAB_EVENTS')}{when && <> · {when}</>}</p>
	{e.item && <p><ItemLink lang={lang} id={e.item} /></p>}
</section>

<section class="page">
	<h2>{L(lang, 'TAB_QUESTS')}</h2>
	<ul class="quest-list">
		{quests.map((id) => <QuestRow lang={lang} id={id} />)}
	</ul>
</section>
