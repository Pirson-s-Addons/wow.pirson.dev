---
// A raid: when it opens, its size, its bosses (and loot when known) and its attunement chain per faction.
import { wow, LANG, type Lang } from '../../lib/atlas/i18n';
import { raidName, name, questName, itemName, href, L, lootId, lootChance, type Raid } from '../../lib/atlas/data';
import { art } from '../../lib/atlas/view';
import ItemLink from './ItemLink.astro';

interface Props {
	lang: Lang;
	r: Raid;
}
const { lang, r } = Astro.props;
const date = (d: string) => new Intl.DateTimeFormat(LANG[lang].html, { dateStyle: 'long' }).format(new Date(`${d}T12:00:00Z`));
const opens = r.unlock ? date(r.unlock) : r.season ? L(lang, `RAID_SEASON_${r.season}`) : L(lang, 'RAID_TBA');
const att = r.attunement;
---

<section class="atlas-hero dungeon-hero">
	<img src={art(r.key)} alt="" width="512" height="256" fetchpriority="high" />
	<div>
		<h1>{raidName(lang, r)}</h1>
		<p class="meta">
			{wow(L(lang, 'RAID_PLAYERS'), r.size)}{' · '}{wow(L(lang, 'RAID_OPENS'), opens)}
			{r.isForever && <> · <span class="tag">{L(lang, 'RAID_UPCOMING_NEW')}</span></>}
		</p>
	</div>
</section>

<div class="page">
	<section>
		<h2>{L(lang, 'TAB_BOSSES')}</h2>
		{!(r.bosses ?? []).length && <p>{L(lang, 'RAID_NO_BOSSES')}</p>}
		{
			(r.bosses ?? []).map((b, i) => (
				<article class="boss" id={`boss-${i + 1}`}>
					<h3>
						<span class="pin-n">{i + 1}</span>
						{b.npcID ? name(lang, `npc:${b.npcID}`, b.name) : b.name}
						{b.level && <small>{wow(L(lang, 'LEVEL'))} {b.level}</small>}
					</h3>
					{b.loot && (
						<ul class="atlas-loot">
							{b.loot.map((e) => {
								const c = lootChance(e);
								return (
									<li>
										<ItemLink lang={lang} id={lootId(e)} note={c ? `${c}%` : undefined} />
									</li>
								);
							})}
						</ul>
					)}
				</article>
			))
		}
		<p class="meta">{r.lootSource === 'classic' ? L(lang, 'RAID_LOOT_CLASSIC') : !(r.bosses ?? []).some((b) => b.loot) && L(lang, 'RAID_NO_LOOT')}</p>
	</section>

	{
		att && (
			<section>
				<h2>{L(lang, 'RAID_TAB_ATTUNE')}</h2>
				<p>{wow(L(lang, 'RAID_ATTUNE_KEY'), itemName(lang, att.item))}</p>
				<ul class="atlas-loot">
					<li>
						<ItemLink lang={lang} id={att.item} />
					</li>
				</ul>
				{(['Alliance', 'Horde'] as const).map(
					(side) =>
						att[side] && (
							<>
								<h3>{L(lang, `FACTION_${side.toUpperCase()}`)}</h3>
								<ol class="chain-steps">
									{att[side]!.map((id) => (
										<li>
											<a href={href(lang, { kind: 'quest', id })}>{questName(lang, id)}</a>
										</li>
									))}
								</ol>
							</>
						),
				)}
			</section>
		)
	}
</div>
