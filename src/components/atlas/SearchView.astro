---
// Search page: the form in the header lands here with ?q=; results are plain links, filtered as you type,
// from this language's index (/atlas/search-<lang>.json, loaded once).
import { T2, type Lang } from '../../lib/atlas/i18n';
import { L } from '../../lib/atlas/data';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = T2[lang];
const types = { d: L(lang, 'TAB_DUNGEONS'), r: L(lang, 'TAB_RAIDS'), e: L(lang, 'TAB_EVENTS'), c: L(lang, 'CHAIN_PART'), q: L(lang, 'TAB_QUESTS'), i: t.items };
---

<section class="atlas-hero">
	<h1>{t.searchTitle}</h1>
	<form role="search" class="atlas-search big" data-search={`/atlas/search-${lang}.json`} data-types={JSON.stringify(types)} data-none={t.searchNone}>
		<input type="search" name="q" placeholder={t.searchLabel} aria-label={t.searchLabel} autocomplete="off" />
	</form>
</section>
<section class="page">
	<p class="search-status" aria-live="polite"></p>
	<ol class="quest-list search-results"></ol>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-search]')!;
	const input = form.querySelector('input')!;
	const list = document.querySelector('.search-results')!;
	const status = document.querySelector('.search-status')!;
	const types: Record<string, string> = JSON.parse(form.dataset.types!);
	// lower case, no Latin accents: "Prisión" finds "prision"
	const fold = (s: string) => s.normalize('NFKD').replace(/(\p{Script=Latin})\p{M}+/gu, '$1').toLowerCase();
	let rows: { name: string; key: string; url: string; type: string; level?: number }[] = [];

	const show = () => {
		const words = fold(input.value).split(/\s+/).filter(Boolean);
		list.replaceChildren();
		if (!words.length) return (status.textContent = '');
		const found = rows
			.filter((r) => words.every((w) => r.key.includes(w)))
			// names that start with the query first, then dungeons before quests before items, then shorter
			.sort((a, b) => +!a.key.startsWith(words[0]) - +!b.key.startsWith(words[0]) || 'dreqci'.indexOf(a.type) - 'dreqci'.indexOf(b.type) || a.name.length - b.name.length)
			.slice(0, 60);
		status.textContent = found.length ? '' : form.dataset.none!;
		for (const r of found) {
			const li = document.createElement('li');
			li.className = 'quest-row';
			const lvl = Object.assign(document.createElement('span'), { className: 'lvl', textContent: r.level ?? '' });
			const a = Object.assign(document.createElement('a'), { href: r.url, textContent: r.name });
			const type = Object.assign(document.createElement('small'), { textContent: types[r.type] });
			li.append(lvl, a, type);
			list.append(li);
		}
	};

	fetch(form.dataset.search!)
		.then((res) => res.json())
		.then((data: [string, string, string, number?][]) => {
			rows = data.map(([name, url, type, level]) => ({ name, key: fold(name), url, type, level }));
			input.value ||= new URLSearchParams(location.search).get('q') ?? '';
			show();
		});
	input.addEventListener('input', show);
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		history.replaceState(null, '', `?q=${encodeURIComponent(input.value)}`);
		show();
	});
	input.focus();
</script>
