---
// Tier 0 and Tier 0.5 of every class: the eight pieces, where each Tier 0 piece drops and which Tier 0.5
// quest gives each piece.
import { T2, className, wow, type Lang } from '../../lib/atlas/i18n';
import { addon, tierPieces, itemDrops, dungeonName, raidName, name, L } from '../../lib/atlas/data';
import ItemLink from './ItemLink.astro';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const sets = addon.TierSets.map((s) => ({ set: s, classes: tierPieces(s) }));
const classes = sets[0].classes.map((c) => c.cls).sort((a, b) => className(lang, a).localeCompare(className(lang, b)));
const source = (id: number) => {
	const s = itemDrops.get(id)?.[0];
	if (!s) return undefined;
	return s.dungeon ? dungeonName(lang, s.dungeon) : s.raid ? raidName(lang, s.raid) : undefined;
};
---

<section class="atlas-hero">
	<h1>{L(lang, 'TIER_TITLE')}</h1>
	<p>{T2[lang].tiersDesc}</p>
	<nav class="jump" aria-label={L(lang, 'TIER_TITLE')}>
		{classes.map((c) => <a href={`#${c.toLowerCase()}`}>{className(lang, c)}</a>)}
	</nav>
</section>

{
	classes.map((cls) => (
		<section class="page" id={cls.toLowerCase()}>
			<h2>{className(lang, cls)}</h2>
			{sets.map(({ set, classes }) => {
				const c = classes.find((x) => x.cls === cls);
				if (!c) return null;
				return (
					<section>
						<h3 class="set-title">
							{L(lang, set.key === 'T0' ? 'TIER_0' : 'TIER_05')} · {c.name}
						</h3>
						<ul class="atlas-loot">
							{c.items.map((id, i) => {
								const step = set.pieceQuest ? set.pieceQuest[i] - 1 : -1;
								const q = set.quests?.[step];
								const note = q ? wow(L(lang, 'TIER05_FROM'), name(lang, `quest:${q}`, set.questNames?.[step])) : source(id);
								return (
									<li>
										<ItemLink lang={lang} id={id} note={note} />
									</li>
								);
							})}
						</ul>
					</section>
				);
			})}
		</section>
	))
}
