---
// The Atlas site frame: header (logo, Discord, download, search, menu with every dungeon, language),
// breadcrumbs, the page, and the footer with the atlas and addon links. Game tooltips: popover="hint"
// shown by the item links (interestfor), polyfilled where missing.
import '@fontsource/marcellus/400.css';
import '../../styles/atlas.css';
import { LANGS, LANG, T, T2, type Lang } from '../../lib/atlas/i18n';
import { url, L, type Page } from '../../lib/atlas/data';
import addons from '../../data/addons.json';

export type Crumb = { label: string; href?: string };
export type Section = 'dungeons' | 'raids' | 'events' | 'journeys' | 'tiers' | 'tutorials' | 'search';
interface Props {
	lang: Lang;
	page: Page;
	title: string;
	description: string;
	section?: Section;
	crumbs?: Crumb[];
}
const { lang, page, title, description, section = 'dungeons', crumbs = [] } = Astro.props;
const site = 'https://wow.pirson.dev';
const alternates = LANGS.flatMap((l) => {
	const u = url(l, page);
	return u ? [{ lang: l, href: u }] : [];
});
const canonical = site + url(lang, page);
const curse = addons.find((a) => a.id === 'dq')?.url ?? 'https://www.curseforge.com/members/pirson/projects';
const discord = 'https://discord.gg/BM3hXNZXTh';
const home = url(lang, { kind: 'home' })!;
const COPIED: Record<Lang, [string, string]> = { en: ['Copied: paste it in the game chat', 'Copy failed'], es: ['Copiado: pégalo en el chat del juego', 'No se pudo copiar'], de: ['Kopiert: im Spielchat einfügen', 'Kopieren fehlgeschlagen'], fr: ['Copié : collez-le dans le chat du jeu', 'Échec de la copie'], it: ['Copiato: incollalo nella chat del gioco', 'Copia non riuscita'], pt: ['Copiado: cole no chat do jogo', 'Falha ao copiar'], ru: ['Скопировано: вставьте в чат игры', 'Не удалось скопировать'], ko: ['복사됨: 게임 채팅에 붙여 넣으세요', '복사 실패'], zh: ['已复制：粘贴到游戏聊天框', '复制失败'], tw: ['已複製：貼到遊戲聊天框', '複製失敗'] };
const DOWNLOAD: Record<Lang, string> = { en: 'Download', es: 'Descargar', de: 'Herunterladen', fr: 'Télécharger', it: 'Scarica', pt: 'Baixar', ru: 'Скачать', ko: '다운로드', zh: '下载', tw: '下載' };
const nav: { key: Section; label: string; href: string }[] = [
	{ key: 'raids', label: L(lang, 'TAB_RAIDS'), href: url(lang, { kind: 'raids' })! },
	{ key: 'events', label: L(lang, 'TAB_EVENTS'), href: url(lang, { kind: 'events' })! },
	{ key: 'journeys', label: L(lang, 'TAB_JOURNEYS'), href: url(lang, { kind: 'reputations' })! },
	{ key: 'tiers', label: L(lang, 'TIER_TITLE'), href: url(lang, { kind: 'tiers' })! },
	{ key: 'tutorials', label: L(lang, 'TAB_TUTORIALS'), href: url(lang, { kind: 'tutorials' })! },
];
---

<!doctype html>
<html lang={LANG[lang].html} dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{alternates.map((a) => <link rel="alternate" hreflang={LANG[a.lang].html} href={site + a.href} />)}
		{alternates.some((a) => a.lang === 'en') && <link rel="alternate" hreflang="x-default" href={site + url('en', page)} />}
		<link rel="icon" href="/favicon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Pirson's Addons" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={LANG[lang].og} />
		<meta property="og:image" content={`${site}/og/dungeon-quest-atlas-${lang === 'es' ? 'es' : 'en'}.jpg`} />
		<meta name="twitter:card" content="summary_large_image" />
		<script defer src="/_vercel/insights/script.js"></script>
	</head>
	<body class="atlas" data-copied={COPIED[lang][0]} data-copy-failed={COPIED[lang][1]}>
		<header class="site-top">
			<a class="brand" href={home}><img src="/atlas/art/logo_dqa.webp" alt="" width="40" height="40" /><span>Dungeon Quest Atlas</span></a>
			<a class="btn-icon" href={discord} rel="noopener" aria-label="Discord" title="Discord">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.3a18.3 18.3 0 0 0-5.6 0L8.6 3a19.7 19.7 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18a19.9 19.9 0 0 0 6 3l1.3-2.1a12.9 12.9 0 0 1-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.8 19.8 0 0 0 6-3c.5-5.2-.9-9.6-3.6-13.6ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.5 8 10.5s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z" /></svg>
			</a>
			<a class="btn-dl" href={curse} rel="noopener">⬇ {DOWNLOAD[lang]}</a>
			{
				page.kind !== 'search' && (
					<form class="searchbox" role="search" action={url(lang, { kind: 'search' })}>
						<input type="search" name="q" placeholder={T2[lang].searchLabel} aria-label={T2[lang].searchTitle} />
					</form>
				)
			}
			<nav aria-label="Dungeon Quest Atlas">
				<ul class="site-nav">
					<li><a href={home} aria-current={section === 'dungeons' ? 'page' : undefined}>{L(lang, 'TAB_DUNGEONS')}</a></li>
					{nav.map((n) => <li><a href={n.href} aria-current={n.key === section ? 'page' : undefined}>{n.label}</a></li>)}
				</ul>
			</nav>
			<details class="dropdown" style="width: 150px">
				<summary aria-label={T[lang].language}>{LANG[lang].name}</summary>
				<ul>
					{
						alternates.map((a) => (
							<li>
								<a href={a.href} hreflang={LANG[a.lang].html} lang={LANG[a.lang].html} aria-current={a.lang === lang ? 'page' : undefined}>
									{LANG[a.lang].name}
								</a>
							</li>
						))
					}
				</ul>
			</details>
		</header>

		<main class="site-main">
			{
				crumbs.length > 0 && (
					<nav aria-label="Breadcrumb">
						<ol class="crumbs">
							<li><a href={home}>{T[lang].atlas}</a></li>
							{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
						</ol>
					</nav>
				)
			}
			<slot />
		</main>

		<footer class="site-foot">
			<div class="cols">
				<div>
					<a class="brand" href={home}><img src="/atlas/art/logo_dqa.webp" alt="" width="40" height="40" loading="lazy" /><span>Dungeon Quest Atlas</span></a>
					<p>{T[lang].ctaText}</p>
				</div>
				<nav aria-label={T[lang].atlas}>
					<h2>{T[lang].atlas}</h2>
					<ul>
						<li><a href={home}>{L(lang, 'TAB_DUNGEONS')}</a></li>
						{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
					</ul>
				</nav>
				<nav aria-label="Dungeon Quest Atlas">
					<h2>{T[lang].ctaTitle}</h2>
					<ul>
						<li><a href={curse} rel="noopener">CurseForge</a></li>
						<li><a href={discord} rel="noopener">Discord</a></li>
						<li><a href={lang === 'es' ? '/es/addons/dungeon-quest-atlas/' : '/addons/dungeon-quest-atlas/'}>{lang === 'es' ? 'Guía del addon' : 'Addon guide'}</a></li>
						<li><a href={lang === 'es' ? '/es/' : '/'}>Pirson's Addons</a></li>
					</ul>
				</nav>
			</div>
			<p class="legal">World of Warcraft® © Blizzard Entertainment. Names, art and tooltips: Blizzard Entertainment, via Wowhead and the game client. Dungeon Quest Atlas is not affiliated with Blizzard.</p>
		</footer>

		<script>
			// popover="hint" + interestfor show the game tooltips. Polyfills only where the browser lacks them.
			if (!Object.hasOwn(HTMLElement.prototype, 'popover')) await import('@oddbird/popover-polyfill');
			if (!('interestForElement' in HTMLButtonElement.prototype)) await import('interestfor');
			// Without anchor positioning the tooltip would sit in the middle of the screen: put it next to its link.
			if (!CSS.supports('position-area: block-end')) {
				document.addEventListener(
					'toggle',
					(e) => {
						const tip = e.target as HTMLElement;
						if ((e as ToggleEvent).newState !== 'open' || !tip.classList?.contains('gtt')) return;
						const link = document.querySelector<HTMLElement>(`[interestfor="${tip.id}"]:hover, [interestfor="${tip.id}"]:focus`);
						if (!link) return;
						const r = link.getBoundingClientRect();
						const w = tip.offsetWidth;
						const left = r.right + 8 + w > innerWidth ? Math.max(4, r.left - w - 8) : r.right + 8;
						Object.assign(tip.style, { position: 'fixed', inset: 'auto', margin: '0', left: `${left + 46}px`, top: `${Math.max(4, Math.min(r.top, innerHeight - tip.offsetHeight - 4))}px` });
					},
					true,
				);
			}
			// copy menus (CopyMenu.astro): each item copies its format of the map point for the game chat
			const timers = new WeakMap<Element, number>();
			const report = (box: HTMLElement, ok: boolean) => {
				const tip = box.querySelector<HTMLElement>(':scope > .tip')!;
				const trigger = box.querySelector<HTMLElement>(':scope > button')!;
				clearTimeout(timers.get(box));
				trigger.removeAttribute('data-copied');
				trigger.removeAttribute('data-failed');
				tip.textContent = '';
				void trigger.offsetWidth;
				trigger.setAttribute(ok ? 'data-copied' : 'data-failed', '');
				requestAnimationFrame(() => (tip.textContent = ok ? document.body.dataset.copied! : document.body.dataset.copyFailed!));
				timers.set(box, window.setTimeout(() => (trigger.removeAttribute('data-copied'), trigger.removeAttribute('data-failed'), (tip.textContent = '')), 2500));
			};
			// without invoker commands, command="toggle-popover" does nothing: popovertarget does the same
			if (!('CommandEvent' in window)) {
				for (const b of document.querySelectorAll<HTMLButtonElement>('button[command="toggle-popover"]')) b.setAttribute('popovertarget', b.getAttribute('commandfor')!);
			}
			const menus = [...document.querySelectorAll<HTMLElement>('.copy-menu')];
			const items = (menu: HTMLElement) => [...menu.querySelectorAll<HTMLButtonElement>('button[data-copy]')];
			const keyboardOpen = new WeakSet<HTMLElement>();
			for (const menu of menus) {
				const box = menu.parentElement!;
				const trigger = box.querySelector<HTMLButtonElement>(':scope > button')!;
				menu.addEventListener('click', async (e) => {
					const item = (e.target as Element).closest<HTMLButtonElement>('button[data-copy]');
					if (!item) return;
					let ok = true;
					try {
						await navigator.clipboard.writeText(item.dataset.copy!);
					} catch {
						ok = false;
					}
					trigger.focus();
					menu.hidePopover();
					report(box, ok);
				});
				// opening from the keyboard enters the menu; from the pointer it does not
				trigger.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' || e.key === ' ') keyboardOpen.add(menu);
					if (e.key === 'ArrowDown') {
						e.preventDefault();
						keyboardOpen.add(menu);
						if (!menu.matches(':popover-open')) trigger.click();
						else items(menu)[0]?.focus();
					}
				});
				menu.addEventListener('toggle', (e) => {
					const open = (e as ToggleEvent).newState === 'open';
					trigger.ariaExpanded = String(open);
					if (open && keyboardOpen.has(menu)) items(menu)[0]?.focus();
					keyboardOpen.delete(menu);
					// no anchor positioning: under the trigger, kept inside the screen
					if (open && !CSS.supports('position-area: block-end')) {
						const r = trigger.getBoundingClientRect();
						const w = menu.offsetWidth;
						Object.assign(menu.style, { position: 'fixed', inset: 'auto', margin: '0', top: `${r.bottom + 4}px`, left: `${Math.max(4, Math.min(r.left, innerWidth - w - 4))}px` });
					}
				});
				// browsers without focusgroup: menu roles and arrow keys by script
				if (!('focusgroup' in HTMLElement.prototype)) {
					const group = menu.querySelector<HTMLElement>('[focusgroup]')!;
					group.setAttribute('role', 'menu');
					for (const b of items(menu)) b.setAttribute('role', 'menuitem');
					group.addEventListener('keydown', (e) => {
						if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
						const list = items(menu);
						const i = list.indexOf(document.activeElement as HTMLButtonElement);
						if (i < 0) return;
						e.preventDefault();
						const n = e.key === 'Home' ? 0 : e.key === 'End' ? list.length - 1 : (i + (e.key === 'ArrowUp' ? -1 : 1) + list.length) % list.length;
						list[n].focus({ preventScroll: true });
					});
				}
			}

			// the tabs of a page: selection follows focus; panels hidden="until-found" stay searchable
			for (const tabs of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
				const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('button')];
				const panels = [...document.querySelectorAll<HTMLElement>(`[data-tab-of="${tabs.dataset.tabs}"]`)];
				const select = (key: string) => {
					for (const b of buttons) {
						b.ariaSelected = String(b.dataset.tab === key);
						b.toggleAttribute('focusgroupstart', b.dataset.tab === key);
					}
					// a list that scrolls sideways (the bosses on a phone) brings the chosen one into view
					const on = buttons.find((b) => b.dataset.tab === key);
					if (on && tabs.scrollWidth > tabs.clientWidth) tabs.scrollLeft += on.getBoundingClientRect().left - tabs.getBoundingClientRect().left - 8;
					for (const p of panels) p.dataset.tab === key ? p.removeAttribute('hidden') : p.setAttribute('hidden', 'until-found');
				};
				for (const b of buttons) {
					b.addEventListener('click', () => select(b.dataset.tab!));
					b.addEventListener('focus', () => select(b.dataset.tab!));
				}
				for (const p of panels) p.addEventListener('beforematch', () => select(p.dataset.tab!));
				if (!('focusgroup' in HTMLElement.prototype)) {
					tabs.setAttribute('role', 'tablist');
					for (const b of buttons) {
						b.setAttribute('role', 'tab');
						b.tabIndex = b.ariaSelected === 'true' ? 0 : -1;
					}
					tabs.addEventListener('keydown', (e) => {
						const i = buttons.indexOf(document.activeElement as HTMLButtonElement);
						if (i < 0 || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) return;
						e.preventDefault();
						const n = e.key === 'Home' ? 0 : e.key === 'End' ? buttons.length - 1 : (i + (e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 1) + buttons.length) % buttons.length;
						for (const b of buttons) b.tabIndex = -1;
						buttons[n].tabIndex = 0;
						buttons[n].focus();
					});
				}
				// a link to #bosses or to something inside a panel (#boss-3): open that tab
				const fromHash = () => {
					const key = decodeURIComponent(location.hash.slice(1));
					if (buttons.some((b) => b.dataset.tab === key)) return select(key);
					const panel = key && document.getElementById(key)?.closest<HTMLElement>(`[data-tab-of="${tabs.dataset.tabs}"]`);
					if (panel) select(panel.dataset.tab!);
				};
				fromHash();
				addEventListener('hashchange', fromHash);
			}
			// card grid filters: kind (round icons) and faction
			for (const grid of document.querySelectorAll<HTMLElement>('[data-grid]')) {
				const state = { kind: 'all', faction: 'Both' };
				const apply = () => {
					for (const li of grid.querySelectorAll<HTMLElement>('.cards > li')) {
						const f = li.dataset.faction ?? 'Both';
						const raid = li.dataset.kind === 'raid';
						li.hidden =
							(state.faction !== 'Both' && f !== 'Both' && f !== state.faction) ||
							(state.kind === 'classic' && (raid || li.dataset.forever === 'true')) ||
							(state.kind === 'forever' && li.dataset.forever !== 'true') ||
							(state.kind === 'raids' && !raid);
					}
				};
				for (const b of grid.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
					b.addEventListener('click', () => {
						const [key, value] = b.dataset.filter!.split(':') as ['kind' | 'faction', string];
						state[key] = value;
						for (const o of grid.querySelectorAll<HTMLButtonElement>(`[data-filter^="${key}:"]`)) o.ariaPressed = String(o === b);
						apply();
					});
				}
			}
		</script>
	</body>
</html>
