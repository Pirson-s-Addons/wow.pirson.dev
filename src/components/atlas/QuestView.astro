---
// A quest: objective, rewards, who gives and takes it, its dungeon and its chain.
import { T, wow, className, type Lang } from '../../lib/atlas/i18n';
import { addon, questName, dungeonName, href, chainOf, chainPage, dungeonOfQuest, L } from '../../lib/atlas/data';
import { questText, place, money } from '../../lib/atlas/view';
import ItemLink from './ItemLink.astro';
import Faction from './Faction.astro';

interface Props {
	lang: Lang;
	id: number;
}
const { lang, id } = Astro.props;
const t = T[lang];
const q = addon.Quests[id];
const { objective, needs } = questText(lang, id);
const chain = chainOf(id);
const dungeons = dungeonOfQuest.get(id) ?? [];
const count = (i: number) => (q.counts?.[i] ? `×${q.counts[i]}` : undefined);
const places = (keys: string[] | undefined) => (keys ?? []).map((k) => place(lang, k));
---

<section class="atlas-hero">
	<h1>{questName(lang, id)}</h1>
	<p class="meta">
		{q.level && <>{wow(L(lang, 'LEVEL'))} <strong>{q.level}</strong></>}
		{q.minLevel && <> · {wow(L(lang, 'REQUIRES_LEVEL'), q.minLevel)}</>}
		{q.classes && <> · {wow(L(lang, 'CLASS_ONLY'), q.classes.map((c) => className(lang, c)).join(', '))}</>}
		<Faction lang={lang} faction={q.faction} />
	</p>
	{
		dungeons.length > 0 && (
			<p class="meta">
				{t.inDungeon}:{' '}
				{dungeons.map((d, i) => (
					<>
						{i > 0 && ', '}
						<a href={href(lang, { kind: 'dungeon', d })}>{dungeonName(lang, d)}</a>
					</>
				))}
			</p>
		)
	}
</section>

<div class="page">
	{
		(objective || needs.length > 0) && (
			<section>
				<h2>{L(lang, 'OBJECTIVES')}</h2>
				{objective && <p>{objective}</p>}
				{needs.length > 0 && (
					<ul class="needs">
						{needs.map((n) => (
							<li>{n}</li>
						))}
					</ul>
				)}
			</section>
		)
	}

	{
		!!(q.choice?.length || q.rewards?.length || q.xp || q.money) && (
			<section>
				<h2>{L(lang, 'REWARDS')}</h2>
				{!!q.choice?.length && (
					<>
						<p>{L(lang, 'CHOOSE_ONE')}</p>
						<ul class="loot">
							{q.choice.map((i) => (
								<li>
									<ItemLink lang={lang} id={i} note={count(i)} />
								</li>
							))}
						</ul>
					</>
				)}
				{!!q.rewards?.length && (
					<ul class="loot">
						{q.rewards.map((i) => (
							<li>
								<ItemLink lang={lang} id={i} note={count(i)} />
							</li>
						))}
					</ul>
				)}
				<p class="meta">
					{!!q.xp && wow(L(lang, 'XP'), q.xp.toLocaleString(lang === 'tw' ? 'zh-TW' : lang))}
					{!!q.xp && !!q.money && ' · '}
					{!!q.money && `${t.money}: ${money(q.money)}`}
				</p>
			</section>
		)
	}

	{
		!!(q.starts?.length || q.ends?.length) && (
			<section>
				<h2>{L(lang, 'WHERE')}</h2>
				<dl class="where">
					{[
						['STARTS', places(q.starts)],
						['ENDS', places(q.ends)],
					].map(([k, list]) =>
						(list as ReturnType<typeof places>).length ? (
							<>
								<dt>{wow(L(lang, k as string))}</dt>
								{(list as ReturnType<typeof places>).map((p) => (
									<dd>
										{p.href ? <a href={p.href}>{p.name}</a> : <strong>{p.name}</strong>}
										{p.where && <small>{p.where}</small>}
									</dd>
								))}
							</>
						) : null,
					)}
				</dl>
			</section>
		)
	}

	{
		chain && (
			<section>
				<h2>{wow(L(lang, 'CHAIN'), chain.indexOf(id) + 1, chain.length)}</h2>
				<ol class="chain-steps">
					{chain.map((s) => (
						<li aria-current={s === id ? 'step' : undefined}>
							{s === id ? <strong>{questName(lang, s)}</strong> : <a href={href(lang, { kind: 'quest', id: s })}>{questName(lang, s)}</a>}
							{addon.Quests[s]?.level && <small>{addon.Quests[s].level}</small>}
						</li>
					))}
				</ol>
				<p>
					<a href={href(lang, { kind: 'chain', steps: chainPage(chain) })}>{t.wholeChain} →</a>
				</p>
			</section>
		)
	}
</div>
