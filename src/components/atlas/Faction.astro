---
// Alliance or Horde crest (nothing for both factions), named for screen readers.
import type { Lang } from '../../lib/atlas/i18n';
import { L } from '../../lib/atlas/data';
import { icon } from '../../lib/atlas/view';

interface Props {
	lang: Lang;
	faction?: string;
}
const { lang, faction } = Astro.props;
const side = faction === 'Alliance' ? 'ALLIANCE' : faction === 'Horde' ? 'HORDE' : null;
---

{
	side && (
		<img
			class="faction"
			src={icon(side === 'ALLIANCE' ? 'ui_allianceicon' : 'ui_hordeicon', 'small')}
			alt={L(lang, `FACTION_${side}`)}
			title={L(lang, `FACTION_${side}`)}
			width="18"
			height="18"
			loading="lazy"
		/>
	)
}
