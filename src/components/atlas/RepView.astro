---
// The new reputations of WoW Forever (the addon's Journeys > Renown): side, where and rewards.
import { T2, wow, type Lang } from '../../lib/atlas/i18n';
import { addon, dungeonName, raidName, href, L } from '../../lib/atlas/data';
import { icon } from '../../lib/atlas/view';
import Faction from './Faction.astro';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = T2[lang];
---

<section class="atlas-hero">
	<h1>{t.repsTitle}</h1>
	<p>{t.repsDesc}</p>
</section>

<section class="page">
	<ul class="rep-list">
		{
			addon.Reputations.map((r) => {
				const d = r.dungeon && addon.Dungeons.find((x) => x.key === r.dungeon);
				const raid = r.raid && addon.Raids.find((x) => x.key === r.raid);
				return (
					<li class="quest-row">
						<img src={icon(r.icons?.[0])} alt="" width="36" height="36" loading="lazy" />
						<strong>{r.name}</strong>
						<Faction lang={lang} faction={r.side} />
						{r.zone && <small>{wow(L(lang, 'JOURNEY_ZONE'), r.zone)}</small>}
						{d && (
							<small>
								{L(lang, 'TAB_DUNGEONS')}: <a href={href(lang, { kind: 'dungeon', d })}>{dungeonName(lang, d)}</a>
							</small>
						)}
						{raid && (
							<small>
								{L(lang, 'TAB_RAIDS')}: <a href={href(lang, { kind: 'raid', r: raid })}>{raidName(lang, raid)}</a>
							</small>
						)}
						{!!r.rewards && <small>{wow(L(lang, 'JOURNEY_REWARDS'), r.rewards)}</small>}
					</li>
				);
			})
		}
	</ul>
</section>
