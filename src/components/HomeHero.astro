---
// Home hero, like a WoW loading screen: the addons' screenshots cross-fade full-screen with a slow
// zoom behind a centred, gilded title. Under it, the numbers bar.
import addons from '../data/addons.json';
import { covers } from '../lib/covers';
import { t } from '../lib/i18n';

const PAGE_TITLE_ID = '_top'; // Starlight's page title id (not exported)
const { entry, lang } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero || {};
const es = lang === 'es';
const total = addons.reduce((s, a) => s + a.downloads, 0);
const versions = new Set(addons.flatMap((a) => a.clients.map((c) => c[0]))).size;
const art = addons.map((a) => covers[a.slug]).filter(Boolean).slice(0, 8);
---

<section class="hx">
	<div class="hx-bg" aria-hidden="true" data-hx-bg>
		{art.map((src, i) => <img src={src} alt="" class:list={[i === 0 && 'is-on']} loading={i === 0 ? 'eager' : 'lazy'} />)}
	</div>
	<div class="hx-embers" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <span style={`--i:${i}`} />)}</div>

	<div class="hx-copy">
		<p class="eyebrow"><img src="/favicon.png" alt="" width="22" height="22" /> Pirson's Addons</p>
		<h1 id={PAGE_TITLE_ID} data-page-title class="hx-title" set:html={title} />
		{tagline && <p class="hx-tagline" set:html={tagline} />}
		<div class="hx-actions">
			{
				actions.map(({ link, text, variant }) => (
					<a href={link} class:list={['btn', variant === 'minimal' ? 'btn-glass' : 'btn-gold']}>
						{text}
					</a>
				))
			}
		</div>
		<p class="mono hx-meta">WoW Forever · MoP Classic · Retail · Classic Era</p>
		<p class="mono hx-meta">{es ? 'Gratis · 20 idiomas · Guías en inglés y español' : 'Free · 20 languages · Guides in English & Español'}</p>
	</div>

	<dl class="hx-stats glass">
		<div><dd data-count={total}>{total.toLocaleString(lang)}</dd><dt>{t(lang, 'downloads')}</dt></div>
		<div><dd data-count={addons.length}>{addons.length}</dd><dt>Addons</dt></div>
		<div><dd data-count={versions}>{versions}</dd><dt>{es ? 'versiones del juego' : 'game versions'}</dt></div>
	</dl>
</section>

<script>
	const bgs = [...document.querySelectorAll<HTMLImageElement>('[data-hx-bg] img')];
	if (bgs.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let on = 0;
		setInterval(() => {
			if (document.hidden) return;
			bgs[on].classList.remove('is-on');
			on = (on + 1) % bgs.length;
			bgs[on].classList.add('is-on');
		}, 6000);
	}
</script>
