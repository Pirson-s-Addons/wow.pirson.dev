---
// Home hero, like a WoW loading screen: in-game footage of several zones cross-fades full-screen
// behind a centred, gilded title, with the zone's name in a corner. Each clip names its zone's
// music (data-music), which src/components/HomeSections.astro plays when the visitor turns sound on.
import addons from '../data/addons.json';
import { t } from '../lib/i18n';

const PAGE_TITLE_ID = '_top'; // Starlight's page title id (not exported)
const { entry, lang } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero || {};
const es = lang === 'es';
const total = addons.reduce((s, a) => s + a.downloads, 0);
const versions = new Set(addons.flatMap((a) => a.clients.map((c) => c[0]))).size;
const clips = [
	['vallefresno-2', 'ashenvale', es ? 'Vallefresno' : 'Ashenvale'],
	['trabalomas-1', 'arathi-warfront', es ? 'Tierras Altas de Arathi' : 'Arathi Highlands'],
	['orgrimmar-1', 'orgrimmar', 'Orgrimmar'],
	['ocean', 'jade-forest', es ? 'La Gran Mar' : 'The Great Sea'],
];
---

<section class="hx" data-zone-src data-music={clips[0][1]}>
	<div class="hx-bg" aria-hidden="true" data-hx-bg>
		{
			clips.map(([clip, music, zone], i) => (
				<video
					src={`/media/bg/${clip}.mp4`}
					poster={i === 0 ? `/media/bg/${clip}.webp` : undefined}
					data-music={music}
					data-zone={zone}
					class:list={[i === 0 && 'is-on']}
					muted
					playsinline
					preload={i === 0 ? 'auto' : 'none'}
				/>
			))
		}
	</div>
	<div class="hx-embers" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <span style={`--i:${i}`} />)}</div>
	<p class="hx-zone mono" aria-hidden="true" data-hx-zone>{clips[0][2]}</p>

	<div class="hx-copy">
		<p class="eyebrow"><img src="/favicon.png" alt="" width="22" height="22" /> Pirson's Addons</p>
		<h1 id={PAGE_TITLE_ID} data-page-title class="hx-title" set:html={title} />
		{tagline && <p class="hx-tagline" set:html={tagline} />}
		<div class="hx-actions">
			{
				actions.map(({ link, text, variant }) => (
					<a href={link} class:list={['btn', variant === 'minimal' ? 'btn-glass' : 'btn-gold']}>
						{text}
					</a>
				))
			}
		</div>
		<p class="mono hx-meta">{es ? 'Gratis · 20 idiomas · Guías en inglés y español' : 'Free · 20 languages · Guides in English & Español'}</p>
	</div>

	<dl class="hx-stats glass">
		<div><dd data-count={total}>{total.toLocaleString(lang)}</dd><dt>{t(lang, 'downloads')}</dt></div>
		<div><dd data-count={addons.length}>{addons.length}</dd><dt>Addons</dt></div>
		<div><dd data-count={versions}>{versions}</dd><dt>{es ? 'versiones del juego' : 'game versions'}</dt></div>
	</dl>
</section>

<script>
	// Plays the zone clips one after another, cross-fading a second before each ends.
	const hx = document.querySelector<HTMLElement>('[data-zone-src].hx');
	const clips = [...document.querySelectorAll<HTMLVideoElement>('[data-hx-bg] video')];
	const label = document.querySelector<HTMLElement>('[data-hx-zone]')!;
	// Reduced motion or data saver: the first clip's poster stays as a still.
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
	if (hx && clips.length && !saveData && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let on = 0;
		const next = () => {
			const old = clips[on];
			on = (on + 1) % clips.length;
			const v = clips[on];
			v.currentTime = 0;
			v.play().catch(() => {});
			v.classList.add('is-on');
			old.classList.remove('is-on');
			label.textContent = v.dataset.zone!;
			hx.dataset.music = v.dataset.music;
			dispatchEvent(new CustomEvent('zone-change'));
			// warm up the clip after this one
			clips[(on + 1) % clips.length].preload = 'auto';
		};
		for (const v of clips) {
			v.addEventListener('timeupdate', () => {
				if (v === clips[on] && v.duration && v.currentTime > v.duration - 1.2) next();
			});
		}
		clips[0].play().catch(() => {});
		clips[1].preload = 'auto';
	}
</script>
